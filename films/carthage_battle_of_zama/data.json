-48.313,5.576L-48.214,5.756L-48.027,5.814L-48.138,5.912L-48.167,6.044L-48.201,6.659L-47.961,6.991L-47.718,7.131L-47.725,7.227L-47.919,7.291L-48.117,7.546L-48.309,7.844L-48.3,8.132L-48.709,8.509L-48.715,8.92L-48.96,9.129L-48.898,9.294L-49.143,9.434L-49.526,9.945L-49.902,10.099L-50.017,10.533L-50.17,10.637L-50.69,10.771L-50.907,11.13L-51.276,11.175L-51.443,11.38L-51.934,11.608L-52.317,12.3L-52.43,12.368L-52.363,12.846L-52.16,13.469L-51.786,14.009L-51.104,14.663L-50.456,14.937L-49.866,14.807L-49.529,14.643L-49.434,14.817L-49.446,15.154L-49.632,15.285L-49.703,15.435L-49.582,15.678L-49.441,15.766L-48.743,15.464L-48.648,15.295L-48.755,15.087L-48.634,14.99L-48.534,15.032L-48.436,14.956L-48.199,15.08L-47.919,15.462L-47.898,15.708L-48.007,15.883L-47.922,16.184L-47.958,16.325L-47.839,16.289L-47.678,16.484L-47.176,16.704L-47.232,16.738L-47.829,16.584L-47.877,16.738L-47.642,17.076L-47.373,17.042L-46.856,17.21L-46.608,17.162L-46.939,16.841L-46.314,17.222L-46.512,18.592L-46.483,19.1L-46.539,19.887L-46.456,20.077L-46.088,20.527L-46.074,20.733L-46.146,20.887L-46.563,21.209L-48.891,22.346L-49.002,22.469L-49.166,22.858ZM-48.51,14.528L-48.55,14.688L-48.55,14.518L-48.614,14.539L-48.831,14.971L-48.899,14.901L-48.876,14.735L-49.082,14.531L-49.153,14.509L-49.338,14.676L-49.433,14.601L-49.483,14.392L-49.403,14.124L-49.45,13.771L-49.299,13.714L-48.79,13.797L-48.659,13.714L-48.128,14.183L-48.51,14.528ZM-48.147,10.159L-48.52,9.984L-48.426,9.91L-47.961,9.914L-47.922,9.97L-48.147,10.159ZM-47.751,9.738L-47.668,9.487L-47.566,9.556L-47.468,9.538L-47.487,9.371L-47.337,9.154L-47.153,9.211L-47.134,9.255L-47.24,9.292L-47.29,9.412L-47.131,9.564L-47.163,9.631L-47.841,9.952L-47.875,9.868L-47.751,9.738Z", "events": [{"year": -205, "title": "Sophonisba's marriage", "text": "Carthage binds King Syphax to its side by marrying him to Sophonisba, daughter of its general Hasdrubal son of Gisco.", "lon": -51.146, "lat": 0.776}, {"year": -205, "title": "Laelius raids Africa", "text": "Scipio's friend Gaius Laelius raids the coast near Hippo Regius, and Carthage fears an invasion.", "lon": -61.543, "lat": 1.021}, {"year": -205, "title": "Masinissa in exile", "text": "Driven from his father's kingdom by Syphax, Masinissa hides with a few riders between the Emporia and the Gaetulian lands.", "lon": -56.936, "lat": -11.734}, {"year": -205, "title": "Carthage arms", "text": "Carthage raises troops, repairs its walls and sends money to Hannibal's brother Mago in Liguria.", "lon": -51.228, "lat": 0.629}, {"year": -205, "title": "Grain of the Emporia", "text": "The rich coastal towns of the Emporia send grain and tribute to Carthage.", "lon": -48.251, "lat": -7.809}, {"year": -204, "title": "The fleet crosses", "text": "Some four hundred transports and forty warships cross from Lilybaeum in Sicily.", "lon": -48.781, "lat": 3.229}, {"year": -204, "title": "Landing at Cape Farina", "text": "Scipio's army lands on the Fair Promontory, north of Utica.", "lon": -51.35, "lat": 2.346}, {"year": -204, "title": "Masinissa joins Scipio", "text": "The exiled prince rides into the Roman camp with a small band of Numidian horsemen.", "lon": -51.962, "lat": 2.002}, {"year": -204, "title": "Ambush at Salaeca", "text": "Masinissa lures Carthage's cavalry into a Roman ambush; its commander Hanno is killed.", "lon": -52.655, "lat": 1.414}, {"year": -204, "title": "Siege of Utica", "text": "Scipio besieges Utica by land and sea, but its walls hold.", "lon": -52.206, "lat": 1.806}, {"year": -204, "title": "Castra Cornelia", "text": "As Hasdrubal and Syphax approach, Scipio lifts the siege and winters on a rocky spur by the sea.", "lon": -51.676, "lat": 2.395}, {"year": -203, "title": "The camps burn", "text": "In a night attack Scipio sets fire to the reed-hut camps of Hasdrubal and Syphax; thousands die.", "lon": -52.573, "lat": 1.512}, {"year": -203, "title": "The Great Plains", "text": "Scipio destroys a new Carthaginian and Numidian army in the Bagradas valley.", "lon": -56.65, "lat": -0.402}, {"year": -203, "title": "Pursuit of Syphax", "text": "Laelius and Masinissa march west; Syphax is captured in June and his capital Cirta falls.", "lon": -57.547, "lat": -0.647}, {"year": -203, "title": "Sophonisba's poison", "text": "Masinissa marries Sophonisba; when Scipio demands her as a captive, she takes poison.", "lon": -58.159, "lat": -1.186}, {"year": -203, "title": "Scipio at Tunes", "text": "Scipio occupies Tunes, in full view of Carthage's walls.", "lon": -51.758, "lat": 0.531}, {"year": -203, "title": "Raid on the fleet", "text": "Carthaginian warships attack Scipio's fleet off Utica and tow away dozens of transports.", "lon": -52.043, "lat": 2.002}, {"year": -203, "title": "Carthage sues for peace", "text": "Thirty elders accept Scipio's terms: give up Spain and the islands, all but twenty warships, and pay five thousand talents.", "lon": -51.554, "lat": 0.678}, {"year": -203, "title": "The truce", "text": "An armistice begins while Carthaginian envoys sail to Rome.", "lon": -51.065, "lat": 0.874}, {"year": -203, "title": "Hannibal lands", "text": "Recalled after fifteen years in Italy, Hannibal lands at Leptis Minor with his veterans.", "lon": -48.863, "lat": -5.013}, {"year": -203, "title": "Winter at Hadrumetum", "text": "Hannibal winters at Hadrumetum, gathering cavalry and elephants.", "lon": -49.841, "lat": -4.228}, {"year": -202, "title": "Convoy wrecked", "text": "A storm drives some two hundred Roman supply ships onto Aegimurus and the shore near Carthage.", "lon": -49.189, "lat": 2.1}, {"year": -202, "title": "Cargo seized", "text": "Hungry crowds in Carthage demand the grain; warships tow the stranded transports into port.", "lon": -51.105, "lat": 0.531}, {"year": -202, "title": "Envoys attacked", "text": "Scipio's envoys are sent away and their ship is attacked off Utica: the truce is broken.", "lon": -52.329, "lat": 2.002}, {"year": -202, "title": "The valley ravaged", "text": "Scipio storms the towns of the Bagradas valley and sells their people into slavery.", "lon": -53.103, "lat": 0.678}, {"year": -202, "title": "March to Zama", "text": "Hannibal marches west from Hadrumetum and camps near Zama, five days from Carthage.", "lon": -52.655, "lat": -4.375}, {"year": -202, "title": "The spies spared", "text": "Scipio has Hannibal's captured spies shown round his camp and sends them back unharmed.", "lon": -58.159, "lat": -2.168}, {"year": -202, "title": "Masinissa arrives", "text": "Masinissa joins Scipio with six thousand infantry and four thousand horsemen.", "lon": -57.711, "lat": -2.511}, {"year": -202, "title": "The generals meet", "text": "Hannibal and Scipio meet between the armies with only interpreters; Scipio refuses terms.", "lon": -56.732, "lat": -2.658}, {"year": -202, "title": "Battle of Zama", "text": "In autumn 202 Scipio defeats Hannibal; Polybius counts twenty thousand Carthaginian dead.", "lon": -55.02, "lat": -2.904}, {"year": -202, "title": "The elephant lanes", "text": "Hannibal's eighty elephants charge, and many run harmlessly down lanes left open in the Roman line.", "lon": -55.713, "lat": -3.394}, {"year": -202, "title": "Naraggara?", "text": "Livy names Naraggara, by today's Sakiet Sidi Youssef, as the site; Polybius names Margaron, still unlocated.", "lon": -59.138, "lat": -2.315}, {"year": -202, "title": "Hannibal escapes", "text": "Hannibal rides to Hadrumetum and then to Carthage, where he advises peace.", "lon": -50.208, "lat": -3.885}, {"year": -202, "title": "Envoys with olive branches", "text": "A Carthaginian ship decked with olive branches meets Scipio's fleet off Carthage.", "lon": -50.616, "lat": 1.119}, {"year": -201, "title": "Peace accepted", "text": "Hannibal pulls a speaker from the platform who argued against the terms, and Carthage accepts.", "lon": -51.146, "lat": 0.825}, {"year": -201, "title": "The fleet burned", "text": "Carthage hands over its warships; all but ten are burned at sea in sight of the city.", "lon": -50.412, "lat": 1.266}, {"year": -201, "title": "The tribute", "text": "Carthage must pay ten thousand talents over fifty years and give up its elephants.", "lon": -51.309, "lat": 0.727}, {"year": -201, "title": "King Masinissa", "text": "Rome recognises Masinissa as king of Numidia, with Syphax's former realm.", "lon": -57.711, "lat": -1.922}, {"year": -201, "title": "Phoenician trenches", "text": "Carthage keeps its lands within the Phoenician trenches, a frontier running south to Thaenae.", "lon": -49.597, "lat": -10.017}, {"year": -201, "title": "Scipio sails home", "text": "Scipio sails from Africa to a triumph in Rome and the name Africanus.", "lon": -51.635, "lat": 2.493}], "eras": [[-205, -205, "Scipio prepares in Sicily"], [-204, -204, "The landing at Utica"], [-203, -203, "Fire, the Great Plains and the truce"], [-202, -202, "The battle of Zama"], [-201, -201, "The peace of 201"]], "refLine": null, "metrics": [{"label": "Carthaginian lands", "stages": [1]}, {"label": "Held by Rome or Masinissa", "stages": [3, 4]}], "chartNote": "Share of the area of modern Tunisia, by who controlled most of each present-day governorate in a given year; regions are today's boundaries, not ancient ones. Control in this war was fluid and frontiers were rarely fixed lines, so this is a simplification; the vast desert south, outside the war, weighs heavily in the shares.", "chartTitle": "Control of today's Tunisia by area", "shares": [[0.5406, 0.4049, 0.0, 0.0, 0.0, 0.0544], [0.5406, 0.382, 0.023, 0.0, 0.0, 0.0544], [0.5406, 0.3432, 0.0152, 0.0465, 0.0544, 0.0], [0.5406, 0.3142, 0.0673, 0.057, 0.0209, 0.0], [0.5406, 0.376, 0.029, 0.0, 0.0544, 0.0]], "seaTile": "data:image/svg+xml;base64,", "theme": {"--sea": "#14304A", "--sea-deep": "#0B1D2E", "--shade": "10,20,30", "--neighbor": "#2E4556", "--neighbor-edge": "#5B7385", "--glaze": "#F8F2E8", "--gold": "#B9863F", "--gold-bright": "#DDAE62", "--accent": "#6B1F4E", "--accent-hover": "#842862", "--ink": "#1E1A22", "--ink-muted": "#625A66", "--paper": "#F2EBDF", "--font-display": "'Marcellus', 'Noto Serif', 'DejaVu Serif', 'Noto Sans CJK JP', Georgia, serif", "--font-body": "'Cardo', 'Noto Serif', 'DejaVu Serif', 'Noto Sans CJK JP', Georgia, serif", "--cobalt": "#14304A", "--cobalt-deep": "#0B1D2E", "--wine": "#6B1F4E"}}