.417,-0.827L-45.308,-0.668L-45.474,-0.255ZM-48.574,-0.766L-48.472,-0.503L-48.601,-0.491L-48.839,-0.56L-48.938,-0.905L-48.705,-0.874L-48.574,-0.766ZM-41.942,-3.67L-41.6,-3.984L-41.375,-3.875L-41.48,-3.588L-41.612,-3.451L-41.736,-3.481L-41.942,-3.67Z", "events": [{"year": -409, "title": "Hannibal lands", "text": "Answering Segesta's appeal against Selinus, Hannibal Mago lands at Cape Lilybaeum; Ephorus gives him 200,000 infantry, Timaeus about 100,000.", "lon": -71.759, "lat": -9.857}, {"year": -409, "title": "Selinus falls", "text": "After nine days of towers, rams and street fighting; Diodorus counts 16,000 dead and over 5,000 captives.", "lon": -67.58, "lat": -12.825}, {"year": -409, "title": "Refugees reach Akragas", "text": "Diodorus says 2,600 people of Selinus escape to Akragas.", "lon": -59.331, "lat": -16.832}, {"year": -409, "title": "Himera razed", "text": "About 3,000 prisoners are tortured and killed where Hamilcar died in 480; mass graves of both battles have been excavated.", "lon": -56.78, "lat": -7.477}, {"year": -408, "title": "Hermocrates at Selinus", "text": "The exiled Syracusan general fortifies part of the ruined city with about 6,000 picked men.", "lon": -67.58, "lat": -12.729}, {"year": -408, "title": "Motya's lands raided", "text": "Hermocrates plunders the territory of Motya, then kills about 500 men outside Panormus.", "lon": -70.782, "lat": -9.036}, {"year": -407, "title": "Hermocrates killed", "text": "Trying to force his way back into Syracuse, he is cut down in the fighting.", "lon": -40.792, "lat": -19.978}, {"year": -407, "title": "Thermae founded", "text": "Carthage plants a new town at the hot springs near Himera's ruins.", "lon": -58.115, "lat": -7.34}, {"year": -406, "title": "Akragas besieged", "text": "Hannibal and Himilco bring a new army; Hannibal dies of plague in the camp.", "lon": -59.331, "lat": -16.422}, {"year": -406, "title": "Akragas falls", "text": "After eight months the people flee by night; the city is sacked and later razed.", "lon": -59.331, "lat": -16.832}, {"year": -405, "title": "Dionysius seizes power", "text": "A young officer uses the panic to become general with supreme powers, then tyrant.", "lon": -40.792, "lat": -19.978}, {"year": -405, "title": "Gela abandoned", "text": "After a fierce defence, Dionysius's relief attack fails and he evacuates the city by night.", "lon": -52.113, "lat": -19.896}, {"year": -405, "title": "Camarina emptied", "text": "Its people are forced onto the road to Syracuse with the Carthaginian army behind them.", "lon": -49.953, "lat": -22.577}, {"year": -405, "title": "Peace of 405", "text": "Carthage keeps the west and takes tribute from five Greek cities; plague has killed over half its army.", "lon": -41.042, "lat": -19.705}, {"year": -404, "title": "Ortygia fortified", "text": "After surviving a revolt, Dionysius turns the island quarter of Syracuse into a fortress for his mercenaries.", "lon": -40.77, "lat": -19.992}, {"year": -403, "title": "Naxos razed", "text": "Betrayed to Dionysius; its people are sold into slavery and the site given to the Sicels.", "lon": -40.988, "lat": -9.556}, {"year": -403, "title": "Catana enslaved", "text": "Betrayed by its general; its people are sold and Campanian mercenaries settled in their place.", "lon": -43.028, "lat": -13.933}, {"year": -403, "title": "Leontini emptied", "text": "Under threat of the same fate, its people are moved to Syracuse.", "lon": -43.972, "lat": -16.901}, {"year": -403, "title": "Henna plundered", "text": "Dionysius takes the Sicel stronghold by treachery and strips it.", "lon": -51.798, "lat": -13.044}, {"year": -401, "title": "Epipolae walled", "text": "Workers wall the plateau above Syracuse in a building campaign Diodorus says took twenty days.", "lon": -41.15, "lat": -19.568}, {"year": -399, "title": "The catapult workshop", "text": "Diodorus says the catapult was invented among craftsmen hired at Syracuse; scholars dispute it.", "lon": -40.933, "lat": -19.841}, {"year": -399, "title": "Great warships built", "text": "Dionysius builds larger warships and 160 ship-sheds in the Great Harbour.", "lon": -40.933, "lat": -20.115}, {"year": -398, "title": "Phoenicians attacked", "text": "As war is declared, mobs in the Greek cities loot and abuse their Phoenician neighbours.", "lon": -41.259, "lat": -20.252}, {"year": -397, "title": "Eryx defects", "text": "Dionysius marches west with, Diodorus says, 80,000 infantry; only five cities stay loyal to Carthage.", "lon": -70.152, "lat": -6.629}, {"year": -397, "title": "Segesta besieged", "text": "Dionysius leaves a force to invest Carthage's Elymian ally.", "lon": -67.482, "lat": -7.928}, {"year": -397, "title": "The causeway is cut", "text": "Motya breaks its own road to the shore; Dionysius sets his army to rebuild it.", "lon": -71.325, "lat": -8.694}, {"year": -397, "title": "Raid on Syracuse", "text": "Ten Carthaginian triremes slip into the harbour by night and sink the ships inside.", "lon": -40.933, "lat": -20.183}, {"year": -397, "title": "Ships hauled overland", "text": "Trapped by Himilco's 100 triremes, Dionysius drags his warships over land to open sea.", "lon": -71.542, "lat": -8.079}, {"year": -397, "title": "Motya falls", "text": "Six-storey towers, rooftop fighting, then a night assault; the soldiers kill until heralds stop them to save slaves.", "lon": -71.455, "lat": -8.94}, {"year": -397, "title": "Mercenaries crucified", "text": "Daimenes and other Greeks who fought for Carthage are crucified.", "lon": -71.433, "lat": -9.036}, {"year": -396, "title": "Himilco lands", "text": "Ephorus gives him over 300,000 men, Timaeus about 130,000; he lands at Panormus.", "lon": -61.773, "lat": -5.535}, {"year": -396, "title": "Motya retaken", "text": "Himilco retakes Eryx and besieges and captures Motya; the city is not rebuilt on its old scale.", "lon": -71.455, "lat": -8.94}, {"year": -396, "title": "Lilybaeum founded", "text": "Motya's survivors are settled on the cape; the fortress will be today's Marsala.", "lon": -71.791, "lat": -9.857}, {"year": -396, "title": "Lipara pays", "text": "Himilco's fleet exacts thirty talents from the Lipari islanders on the way east.", "lon": -44.461, "lat": -0.734}, {"year": -396, "title": "Messana levelled", "text": "Himilco storms and razes the city at the strait to deny it to the Greeks.", "lon": -37.959, "lat": -4.482}, {"year": -396, "title": "Tauromenium settled", "text": "Sicels who desert Dionysius wall a new town on Mount Taurus.", "lon": -40.846, "lat": -9.132}, {"year": -396, "title": "Battle off Catana", "text": "Mago's fleet sinks over 100 Greek ships; Diodorus counts over 20,000 dead.", "lon": -42.453, "lat": -13.96}, {"year": -396, "title": "Syracuse besieged", "text": "Himilco camps by the Great Harbour and takes the suburb with the temples of Demeter and Kore.", "lon": -41.259, "lat": -20.115}, {"year": -396, "title": "Plague in the camp", "text": "Death comes on the fifth or sixth day; Diodorus counts over 150,000 unburied dead.", "lon": -41.15, "lat": -20.388}, {"year": -396, "title": "Fleet burned at Dascon", "text": "Dionysius attacks the camp by land and sea and fires the ships at anchor.", "lon": -40.933, "lat": -20.388}, {"year": -396, "title": "Himilco's bargain", "text": "He pays 300 talents and flees with his citizens in forty ships, abandoning his mercenaries and allies.", "lon": -40.499, "lat": -20.388}], "eras": [[-409, -407, "Carthage Returns"], [-406, -405, "The Fall of the Greek South"], [-404, -398, "Dionysius Arms"], [-397, -397, "The Siege of Motya"], [-396, -396, "Himilco's Counterstroke"]], "refLine": null, "metrics": [{"label": "Held by Carthage", "stages": [3]}, {"label": "Held by Syracuse", "stages": [2]}], "chartNote": "Share of the area of Sicily, by the status of the leading city or people in each of today's provinces: a simplification, since the ancient territories followed other lines and one province could hold enemies (Motya and Segesta in Trapani; Himera and Panormus in Palermo). Diodorus Siculus is the main source and his numbers are debatable. Motya's fall follows the excavators' date of 397 BC; some handbooks give 398.", "chartTitle": "Sicily by who held it", "shares": [[0.0988, 0.5254, 0.0837, 0.0961, 0.196], [0.0988, 0.5254, 0.0837, 0.0961, 0.196], [0.0988, 0.5254, 0.0837, 0.2921, 0.0], [0.0988, 0.4093, 0.0837, 0.2921, 0.1161], [0.0988, 0.2651, 0.0837, 0.2921, 0.2604], [0.0988, 0.2651, 0.0837, 0.5524, 0.0], [0.0988, 0.1274, 0.2213, 0.5524, 0.0], [0.0988, 0.1274, 0.2213, 0.5524, 0.0], [0.0988, 0.1274, 0.2213, 0.5524, 0.0], [0.0988, 0.1274, 0.2213, 0.5524, 0.0], [0.0988, 0.1274, 0.2213, 0.5524, 0.0], [0.0988, 0.1274, 0.2213, 0.5524, 0.0], [0.0988, 0.1274, 0.5778, 0.196, 0.0], [0.0988, 0.1161, 0.3656, 0.2921, 0.1274]], "seaTile": "data:image/svg+xml;base64,", "theme": {"--sea": "#14304A", "--sea-deep": "#0B1D2E", "--shade": "10,20,30", "--neighbor": "#2E4556", "--neighbor-edge": "#5B7385", "--glaze": "#F8F2E8", "--gold": "#B9863F", "--gold-bright": "#DDAE62", "--accent": "#6B1F4E", "--accent-hover": "#842862", "--ink": "#1E1A22", "--ink-muted": "#625A66", "--paper": "#F2EBDF", "--font-display": "'Marcellus', 'Noto Serif', 'DejaVu Serif', 'Noto Sans CJK JP', Georgia, serif", "--font-body": "'Cardo', 'Noto Serif', 'DejaVu Serif', 'Noto Sans CJK JP', Georgia, serif", "--cobalt": "#14304A", "--cobalt-deep": "#0B1D2E", "--wine": "#6B1F4E"}}