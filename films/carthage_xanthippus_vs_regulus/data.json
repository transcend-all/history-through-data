-54.597,12.099L-55.214,12.393L-55.246,12.316L-55.133,12.197Z", "events": [{"year": -256, "title": "Battle of Ecnomus", "text": "About 330 Roman warships defeat 350 Carthaginian ships off Sicily, sinking over 30 and capturing 64 for 24 lost.", "lon": -44.815, "lat": -1.666}, {"year": -256, "title": "Hamilcar recalled", "text": "Carthage summons Hamilcar and part of his army home from Heraclea Minoa to meet the invasion.", "lon": -47.23, "lat": -0.138}, {"year": -256, "title": "Recruiters in Greece", "text": "Carthaginian agents hire soldiers in Greece; among them is a man trained at Sparta, Xanthippus.", "lon": -13.239, "lat": -1.531}, {"year": -256, "title": "Landing at Aspis", "text": "The consuls Regulus and Manlius land on Cape Bon and take the fort of Aspis, modern Kelibia.", "lon": -55.366, "lat": -2.565}, {"year": -256, "title": "Cape Bon plundered", "text": "The Romans loot the rich estates of the peninsula and carry off some 20,000 captives.", "lon": -56.257, "lat": -3.149}, {"year": -256, "title": "Kerkouane abandoned", "text": "This Punic town on Cape Bon is destroyed around now, traditionally by Regulus, and never resettled.", "lon": -55.477, "lat": -1.891}, {"year": -256, "title": "Manlius sails home", "text": "Manlius returns with most of the fleet; Regulus stays with 15,000 infantry, 500 cavalry and 40 ships.", "lon": -54.771, "lat": -1.666}, {"year": -256, "title": "Battle of Adys", "text": "Three Punic generals camp on a hill where elephants and cavalry are useless; Regulus storms it.", "lon": -58.783, "lat": -3.644}, {"year": -256, "title": "Regulus takes Tunis", "text": "The Romans make Tunis their winter base, in sight of Carthage across the lake.", "lon": -58.746, "lat": -2.79}, {"year": -256, "title": "Numidian raids", "text": "Numidians raid Carthaginian lands; Polybius judges their damage worse than the Romans'.", "lon": -64.244, "lat": -5.486}, {"year": -256, "title": "Refugees and famine", "text": "Country people flee behind Carthage's walls, and the crowded city runs short of food.", "lon": -58.189, "lat": -2.52}, {"year": -256, "title": "The Bagradas serpent", "text": "Later Roman writers place a 120-foot serpent at Regulus's river camp; Polybius knows nothing of it.", "lon": -59.712, "lat": -1.981}, {"year": -255, "title": "Terms refused", "text": "Regulus offers peace on terms Polybius calls unbearable; Carthage's Senate chooses to fight on.", "lon": -58.189, "lat": -2.34}, {"year": -255, "title": "82 towns surrender", "text": "Orosius, a late source, counts 82 towns going over to Rome; Polybius says only 'many'.", "lon": -58.858, "lat": -5.037}, {"year": -255, "title": "Xanthippus takes command", "text": "The Spartan-trained officer blames the generals, not the troops, and is handed the army.", "lon": -58.301, "lat": -2.61}, {"year": -255, "title": "Drill before the walls", "text": "Xanthippus manoeuvres the army outside the city, and the citizens' despair turns to hope.", "lon": -58.412, "lat": -2.43}, {"year": -255, "title": "Battle of the Bagradas", "text": "Xanthippus's elephants and cavalry destroy Regulus's army on open ground; the exact site is unknown.", "lon": -59.341, "lat": -2.25}, {"year": -255, "title": "Regulus captured", "text": "Regulus and about 500 men are taken alive; Carthage's own losses are about 800 mercenaries.", "lon": -59.044, "lat": -1.981}, {"year": -255, "title": "Survivors reach Aspis", "text": "About 2,000 Romans escape to Aspis and beat off a Carthaginian siege.", "lon": -55.254, "lat": -2.79}, {"year": -255, "title": "Xanthippus sails away", "text": "Polybius says the Spartan left soon after his victory, a prudent escape from envy.", "lon": -57.743, "lat": -1.891}, {"year": -255, "title": "Cape Hermaeum", "text": "Rome's rescue fleet of 350 ships defeats the Carthaginians and captures 114 of their vessels.", "lon": -55.514, "lat": -1.531}, {"year": -255, "title": "Storm off Camarina", "text": "Of 364 ships carrying the rescued army home, only 80 survive the storm.", "lon": -42.884, "lat": -2.475}, {"year": -254, "title": "Hamilcar's reprisals", "text": "Orosius reports a fine of 1,000 talents and 20,000 cattle on the Numidians, and their chiefs crucified.", "lon": -64.207, "lat": -5.576}, {"year": -254, "title": "Elephants to Sicily", "text": "Hasdrubal lands at Lilybaeum with 140 elephants to carry the war back to Sicily.", "lon": -50.351, "lat": 1.705}, {"year": -254, "title": "A new fleet", "text": "Rome builds 220 ships in three months; at Messana they pick up the storm's surviving ships.", "lon": -38.797, "lat": 3.457}, {"year": -254, "title": "Panormus falls", "text": "Roman forces take Panormus, Carthage's great base in northern Sicily.", "lon": -46.933, "lat": 3.143}, {"year": -253, "title": "Raid on Africa", "text": "A Roman fleet raids Africa's eastern coast, with little to show for it.", "lon": -55.514, "lat": -8.407}, {"year": -253, "title": "Aground at Meninx", "text": "The fleet is stranded on the shoals of Meninx and escapes only by throwing its cargo overboard.", "lon": -56.257, "lat": -16.272}, {"year": -253, "title": "A second fleet lost", "text": "Sailing home from Panormus, the Romans lose over 150 ships to another storm.", "lon": -46.041, "lat": 4.491}, {"year": -252, "title": "Thermae falls", "text": "Rome, wary of the sea after its losses, takes the Sicilian town of Thermae by siege.", "lon": -45.67, "lat": 2.514}, {"year": -252, "title": "Lipara falls", "text": "Roman forces take the island base of Lipara.", "lon": -41.026, "lat": 4.716}, {"year": -252, "title": "Fear of elephants", "text": "For two years Roman armies keep to the hills of Sicily and refuse battle on flat ground.", "lon": -44.37, "lat": 0.806}, {"year": -251, "title": "Carthage holds the sea", "text": "With Rome's fleets wrecked, Carthage's ships dominate the waters between Africa and Sicily.", "lon": -50.499, "lat": -3.689}, {"year": -251, "title": "Caecilius at Panormus", "text": "The consul Lucius Caecilius Metellus holds Panormus while his colleague takes half the forces home.", "lon": -47.156, "lat": 2.693}, {"year": -250, "title": "Battle of Panormus", "text": "Caecilius's javelin men drive Hasdrubal's elephants back into their own lines.", "lon": -46.599, "lat": 3.053}, {"year": -250, "title": "The elephants captured", "text": "Polybius says the whole herd is taken; they will later be shown at Rome.", "lon": -47.527, "lat": 3.278}, {"year": -250, "title": "The embassy of Regulus", "text": "Roman tradition, not Polybius, has Regulus sent to Rome to bargain, then returning on his oath.", "lon": -58.078, "lat": -2.655}, {"year": -250, "title": "Regulus dies", "text": "He dies a captive, by torture in the legend; Diodorus's widow story points instead to neglect.", "lon": -58.226, "lat": -2.7}, {"year": -250, "title": "Siege of Lilybaeum", "text": "Rome's new fleet and army begin a siege of Carthage's last strongholds in Sicily.", "lon": -50.351, "lat": 1.525}, {"year": -249, "title": "Battle of Drepana", "text": "The Carthaginian admiral Adherbal destroys a Roman fleet under Publius Claudius Pulcher.", "lon": -50.091, "lat": 2.693}, {"year": -249, "title": "Storm off Pachynus", "text": "Two more Roman fleets are wrecked near Sicily's southern cape, and Rome all but leaves the sea.", "lon": -40.469, "lat": -3.329}], "eras": [[-256, -256, "The Invasion of Africa"], [-255, -255, "The Spartan and the Storm"], [-254, -253, "Reprisals and Wrecks"], [-252, -249, "The War Returns to Sicily"]], "refLine": null, "metrics": [{"label": "Carthaginian-held", "stages": [0]}, {"label": "Lost or in dispute", "stages": [1, 2, 3]}], "chartNote": "Share of the area of modern Tunisia, by present-day governorate, a simplification: these borders did not exist, and the sources rarely say who held what inland. Categories are judgements from literary sources, chiefly Polybius. The desert governorates of Tozeur, Kebili and Tataouine lay beyond Punic rule and are counted in no category, so the shares do not reach 100%.", "chartTitle": "Control of Carthage's homeland by area", "shares": [[0.5159, 0.0186, 0.0, 0.0249], [0.1431, 0.0417, 0.2973, 0.0772], [0.3571, 0.0, 0.0, 0.2024], [0.2742, 0.0, 0.0, 0.2852], [0.4594, 0.0, 0.0, 0.1001], [0.4594, 0.0, 0.0, 0.1001], [0.4594, 0.0, 0.0, 0.1001], [0.4594, 0.0, 0.0, 0.1001]], "seaTile": "data:image/svg+xml;base64,", "theme": {"--sea": "#14304A", "--sea-deep": "#0B1D2E", "--shade": "10,20,30", "--neighbor": "#2E4556", "--neighbor-edge": "#5B7385", "--glaze": "#F8F2E8", "--gold": "#B9863F", "--gold-bright": "#DDAE62", "--accent": "#6B1F4E", "--accent-hover": "#842862", "--ink": "#1E1A22", "--ink-muted": "#625A66", "--paper": "#F2EBDF", "--font-display": "'Marcellus', 'Noto Serif', 'DejaVu Serif', 'Noto Sans CJK JP', Georgia, serif", "--font-body": "'Cardo', 'Noto Serif', 'DejaVu Serif', 'Noto Sans CJK JP', Georgia, serif", "--cobalt": "#14304A", "--cobalt-deep": "#0B1D2E", "--wine": "#6B1F4E"}}