L-45.051,0.301L-44.953,0.073L-44.788,-0.023L-44.43,-0.019L-44.341,0.06L-44.419,0.257L-44.197,0.453L-44.197,0.537L-44.486,0.537ZM-51.066,-0.198L-51.106,-0.364L-50.95,-0.418L-50.91,-0.251L-51.066,-0.198ZM-45.474,-0.255L-45.883,-0.426L-46.211,-0.697L-45.981,-0.864L-45.585,-0.879L-45.417,-0.827L-45.308,-0.668L-45.474,-0.255ZM-48.574,-0.766L-48.472,-0.503L-48.601,-0.491L-48.839,-0.56L-48.938,-0.905L-48.705,-0.874L-48.574,-0.766ZM-41.942,-3.67L-41.6,-3.984L-41.375,-3.875L-41.48,-3.588L-41.612,-3.451L-41.736,-3.481L-41.942,-3.67Z", "events": [{"year": -250, "title": "Battle of Panormus", "text": "Lucius Caecilius Metellus routs Hasdrubal's army beneath the walls of Panormus and captures his war elephants.", "lon": -61.773, "lat": -5.617}, {"year": -250, "title": "Elephants to Rome", "text": "The captured elephants are ferried across the strait on rafts and paraded in Metellus's triumph.", "lon": -37.894, "lat": -4.386}, {"year": -250, "title": "Lilybaeum besieged", "text": "Both consuls invest Lilybaeum by land and sea with four legions and some two hundred ships.", "lon": -71.65, "lat": -9.857}, {"year": -250, "title": "Rams and mines", "text": "Roman rams batter the seaward towers; Himilco answers with counter-mines and new inner walls.", "lon": -71.759, "lat": -9.994}, {"year": -250, "title": "Mercenary plot foiled", "text": "A Greek officer, Alexon, warns Himilco that mercenary captains plan to betray the city.", "lon": -71.867, "lat": -9.72}, {"year": -250, "title": "Relief fleet runs in", "text": "Hannibal, son of Hamilcar, runs fifty ships and ten thousand men into the harbour on a following wind.", "lon": -72.193, "lat": -9.583}, {"year": -250, "title": "The Rhodian's runs", "text": "Hannibal the Rhodian sails in and out of the blockaded harbour in daylight, carrying news to Carthage.", "lon": -72.41, "lat": -9.31}, {"year": -250, "title": "Harbour mole", "text": "The Romans try to close the harbour mouth with a stone mole; the sea scours much of it away.", "lon": -72.084, "lat": -9.72}, {"year": -250, "title": "Rhodian captured", "text": "A captured Punic warship, manned by Romans, runs down the Rhodian; Rome keeps his ship as a model.", "lon": -72.519, "lat": -9.583}, {"year": -250, "title": "Siege towers burned", "text": "A gale fans the fire of a Punic sortie through the Roman siege engines.", "lon": -71.542, "lat": -9.994}, {"year": -249, "title": "Night sailing", "text": "The consul Publius Claudius Pulcher sails at midnight from Lilybaeum to surprise the fleet at Drepana.", "lon": -71.65, "lat": -9.036}, {"year": -249, "title": "Sacred chickens", "text": "Later Roman writers tell how the chickens refused to eat and Claudius threw them overboard: \"let them drink\".", "lon": -71.867, "lat": -9.447}, {"year": -249, "title": "Battle of Drepana", "text": "Adherbal pins the Roman fleet against the shore; Claudius loses ninety-three of his hundred and twenty-three ships.", "lon": -71.433, "lat": -6.848}, {"year": -249, "title": "Carthalo strikes", "text": "Carthalo attacks the Roman ships off Lilybaeum and burns several of them.", "lon": -72.193, "lat": -10.13}, {"year": -249, "title": "Refuge at Phintias", "text": "Junius's convoy shelters at Phintias from Carthalo's squadron.", "lon": -55.478, "lat": -19.431}, {"year": -249, "title": "Fleet wrecked", "text": "A storm off Camarina destroys Junius's fleet and its convoy; only two warships survive.", "lon": -49.942, "lat": -22.714}, {"year": -249, "title": "Romans seize Eryx", "text": "Junius takes Mount Eryx, its summit temple of Venus and the town below, overlooking Drepana.", "lon": -70.131, "lat": -6.574}, {"year": -248, "title": "Hiero's treaty", "text": "Rome makes its alliance with Hiero II of Syracuse permanent.", "lon": -40.825, "lat": -19.841}, {"year": -248, "title": "Siege by land", "text": "With almost no fleet left, Rome holds on around Lilybaeum and Drepana by land.", "lon": -71.216, "lat": -9.857}, {"year": -247, "title": "Hamilcar lands", "text": "Hamilcar Barca, newly in command, lands behind Roman lines near Panormus.", "lon": -62.424, "lat": -4.523}, {"year": -247, "title": "Heircte seized", "text": "Hamilcar fortifies Heircte, a sheer mountain with a harbour above Panormus, probably Monte Pellegrino.", "lon": -61.882, "lat": -4.796}, {"year": -246, "title": "War of skirmishes", "text": "For three years Hamilcar's troops ambush and skirmish with the Roman army camped nearby.", "lon": -61.556, "lat": -5.754}, {"year": -245, "title": "Islet off Drepana", "text": "The consul Fabius Buteo occupies an islet at the mouth of Drepana harbour.", "lon": -71.216, "lat": -6.985}, {"year": -244, "title": "Heircte abandoned", "text": "Hamilcar evacuates Heircte by sea under cover of night.", "lon": -61.99, "lat": -4.659}, {"year": -244, "title": "Eryx taken", "text": "Hamilcar seizes the town of Eryx, between the Romans on the summit and the camp at the foot.", "lon": -70.131, "lat": -6.711}, {"year": -243, "title": "Gauls desert", "text": "Gallic mercenaries of Hamilcar's army desert to Rome and later plunder the temple of Venus.", "lon": -70.152, "lat": -6.629}, {"year": -243, "title": "Summit holds", "text": "The Roman garrison on the summit holds out; neither side can dislodge the other.", "lon": -70.022, "lat": -6.438}, {"year": -242, "title": "Rome's last fleet", "text": "Citizens lend the state money for two hundred quinqueremes built on the Rhodian's model.", "lon": -70.89, "lat": -6.301}, {"year": -242, "title": "Drepana harbour seized", "text": "Lutatius Catulus finds the sea empty of Punic warships and seizes Drepana's harbour.", "lon": -71.108, "lat": -6.848}, {"year": -242, "title": "Catulus wounded", "text": "Catulus is wounded in an assault on Drepana and trains his crews at sea.", "lon": -70.782, "lat": -6.985}, {"year": -242, "title": "Lilybaeum blockaded", "text": "The Roman fleet closes the anchorages of Lilybaeum.", "lon": -71.976, "lat": -9.857}, {"year": -241, "title": "Hanno's convoy", "text": "Hanno's relief fleet, laden with grain for Eryx, sails in from the Aegates.", "lon": -73.604, "lat": -7.805}, {"year": -241, "title": "Battle of the Aegates", "text": "On 10 March Catulus's fleet sinks fifty Carthaginian ships and captures seventy.", "lon": -73.387, "lat": -7.258}, {"year": -241, "title": "Hamilcar negotiates", "text": "Given full powers by Carthage, Hamilcar makes peace with Catulus.", "lon": -70.239, "lat": -6.711}, {"year": -241, "title": "Army marches out", "text": "Hamilcar refuses to surrender his men's weapons; the unbeaten army leaves Eryx armed.", "lon": -70.022, "lat": -6.848}, {"year": -241, "title": "Gisco ships them home", "text": "Gisco, commander at Lilybaeum, ships the army back to Africa in detachments.", "lon": -71.867, "lat": -9.857}, {"year": -241, "title": "Peace of Lutatius", "text": "Carthage leaves Sicily and agrees to pay 3,200 talents; Sicily becomes Rome's first province.", "lon": -61.773, "lat": -5.48}, {"year": -241, "title": "Hiero's kingdom spared", "text": "Syracuse remains an independent kingdom, protected by the treaty.", "lon": -41.042, "lat": -20.115}], "eras": [[-250, -250, "The Siege of Lilybaeum"], [-249, -248, "Drepana and the Storms"], [-247, -245, "Hamilcar on Heircte"], [-244, -243, "The War on Eryx"], [-242, -241, "The Last Fleet"]], "refLine": null, "metrics": [{"label": "Carthaginian strongholds", "stages": [3]}, {"label": "Fought over", "stages": [2, 3]}], "chartNote": "Share of the area of modern Sicily, by who controlled each present-day province. Regions are today's boundaries and a simplification: the province of Trapani held the besieged Punic ports of Lilybaeum and Drepana, the Roman siege lines and, from 244 BC, Hamilcar's foothold on Eryx, all at once. Dates follow Polybius's chronology.", "chartTitle": "Control of Sicily by area", "shares": [[0.6243, 0.0837, 0.196, 0.0961], [0.8203, 0.0837, 0.0, 0.0961], [0.8203, 0.0837, 0.0, 0.0961], [0.6243, 0.0837, 0.196, 0.0961], [0.6243, 0.0837, 0.196, 0.0961], [0.6243, 0.0837, 0.196, 0.0961], [0.8203, 0.0837, 0.0, 0.0961], [0.8203, 0.0837, 0.0, 0.0961], [0.8203, 0.0837, 0.0, 0.0961], [0.9163, 0.0837, 0.0, 0.0]], "seaTile": "data:image/svg+xml;base64,", "theme": {"--sea": "#14304A", "--sea-deep": "#0B1D2E", "--shade": "10,20,30", "--neighbor": "#2E4556", "--neighbor-edge": "#5B7385", "--glaze": "#F8F2E8", "--gold": "#B9863F", "--gold-bright": "#DDAE62", "--accent": "#6B1F4E", "--accent-hover": "#842862", "--ink": "#1E1A22", "--ink-muted": "#625A66", "--paper": "#F2EBDF", "--font-display": "'Marcellus', 'Noto Serif', 'DejaVu Serif', 'Noto Sans CJK JP', Georgia, serif", "--font-body": "'Cardo', 'Noto Serif', 'DejaVu Serif', 'Noto Sans CJK JP', Georgia, serif", "--cobalt": "#14304A", "--cobalt-deep": "#0B1D2E", "--wine": "#6B1F4E"}}