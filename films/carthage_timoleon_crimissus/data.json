1L-49.537,23.625L-49.663,23.467L-50.544,21.551L-50.812,21.167L-51.8,20.197L-52.563,19.689L-53.455,19.263L-53.864,19.188L-55.083,19.29ZM-72.821,8.308L-73.124,8.144L-73.282,8.226L-73.411,8.195L-73.569,7.949L-73.42,7.962L-73.124,7.855L-72.879,8.037L-72.531,8.144L-72.652,8.297L-72.821,8.308ZM-75.835,7.31L-75.674,7.802L-75.831,7.794L-76.018,7.658L-76.204,7.335L-76.144,7.244L-75.953,7.225L-75.835,7.31ZM-63.843,-2.689L-63.665,-2.692L-63.537,-2.567L-63.762,-2.357L-63.887,-2.331L-64.014,-2.381L-64.019,-2.484L-63.843,-2.689ZM-44.419,1.2L-44.338,1.2L-44.338,1.395L-44.041,1.609L-43.893,1.956L-44.115,2.142L-44.534,1.699L-44.566,1.483L-44.419,1.2ZM-44.486,0.537L-44.338,0.92L-44.529,0.954L-45.064,0.533L-45.051,0.301L-44.953,0.073L-44.788,-0.023L-44.43,-0.019L-44.341,0.06L-44.419,0.257L-44.197,0.453L-44.197,0.537L-44.486,0.537ZM-51.066,-0.198L-51.106,-0.364L-50.95,-0.418L-50.91,-0.251L-51.066,-0.198ZM-45.474,-0.255L-45.883,-0.426L-46.211,-0.697L-45.981,-0.864L-45.585,-0.879L-45.417,-0.827L-45.308,-0.668L-45.474,-0.255ZM-48.574,-0.766L-48.472,-0.503L-48.601,-0.491L-48.839,-0.56L-48.938,-0.905L-48.705,-0.874L-48.574,-0.766ZM-41.942,-3.67L-41.6,-3.984L-41.375,-3.875L-41.48,-3.588L-41.612,-3.451L-41.736,-3.481L-41.942,-3.67Z", "events": [{"year": -345, "title": "Appeal to Corinth", "text": "Syracusan exiles ask their mother city, Corinth, to free them from their tyrants.", "lon": -40.825, "lat": -19.841}, {"year": -345, "title": "Dionysius in Ortygia", "text": "Dionysius II, back in power, holds the island fortress of Ortygia at the heart of Syracuse.", "lon": -40.792, "lat": -19.992}, {"year": -345, "title": "Hicetas of Leontini", "text": "Hicetas, tyrant of Leontini, marches on Syracuse and secretly negotiates with Carthage.", "lon": -43.972, "lat": -16.832}, {"year": -345, "title": "Carthage arms", "text": "Carthage sends a fleet and an army to Sicily to profit from the Greeks' civil wars.", "lon": -71.759, "lat": -9.857}, {"year": -345, "title": "Mamercus of Catana", "text": "The Italian mercenary captain Mamercus rules Catana as its tyrant.", "lon": -42.996, "lat": -13.96}, {"year": -344, "title": "Ruse at Rhegium", "text": "Timoleon's ten ships slip past twenty Carthaginian warships while a public debate keeps their envoys busy.", "lon": -36.917, "lat": -5.617}, {"year": -344, "title": "Landing at Tauromenium", "text": "Andromachus, ruler of Tauromenium, welcomes Timoleon and his small army.", "lon": -40.825, "lat": -9.173}, {"year": -344, "title": "Battle of Adranum", "text": "With about twelve hundred men, Timoleon surprises and routs Hicetas' five thousand at dusk.", "lon": -45.818, "lat": -11.772}, {"year": -344, "title": "Assassins foiled", "text": "Two assassins sent by Hicetas are stopped at the temple of Adranum before they can strike Timoleon.", "lon": -45.709, "lat": -11.635}, {"year": -344, "title": "Mamercus allies", "text": "After Adranum, Mamercus of Catana and other towns join Timoleon.", "lon": -42.996, "lat": -13.823}, {"year": -344, "title": "Hicetas takes Syracuse", "text": "Hicetas captures the city and besieges Dionysius in Ortygia.", "lon": -40.933, "lat": -19.705}, {"year": -344, "title": "Dionysius surrenders", "text": "Dionysius hands Ortygia, its arsenal and two thousand soldiers to Timoleon and sails to Corinth.", "lon": -40.792, "lat": -19.978}, {"year": -344, "title": "Mago's fleet", "text": "The Carthaginian commander Mago sails into the Great Harbour with a hundred and fifty warships.", "lon": -41.042, "lat": -20.115}, {"year": -343, "title": "Neon's sally", "text": "Neon, Corinthian commander of the besieged citadel, breaks out and seizes the Achradina quarter.", "lon": -40.825, "lat": -19.705}, {"year": -343, "title": "Talk by the marshes", "text": "Greek mercenaries on both sides, fishing for eels, ask why Greeks should fight Greeks for Carthage.", "lon": -41.15, "lat": -19.978}, {"year": -343, "title": "Mago sails away", "text": "Fearing betrayal, Mago withdraws his whole fleet; in Carthage he later kills himself.", "lon": -40.716, "lat": -20.388}, {"year": -343, "title": "Syracuse is free", "text": "Timoleon takes the whole city with little fighting; Hicetas falls back to Leontini.", "lon": -40.825, "lat": -19.841}, {"year": -343, "title": "Fortress torn down", "text": "Syracusans demolish the tyrants' fortress on Ortygia and build courts of law on its site.", "lon": -40.803, "lat": -19.951}, {"year": -343, "title": "A new priesthood", "text": "Syracuse creates an annual priest of Olympian Zeus, by whose name the years are dated.", "lon": -41.259, "lat": -20.252}, {"year": -342, "title": "Settlers arrive", "text": "Corinth calls Greeks to repopulate Syracuse; ancient writers speak of tens of thousands of new citizens.", "lon": -40.825, "lat": -19.841}, {"year": -342, "title": "New laws", "text": "Two Corinthian lawgivers, Cephalus and Dionysius, revise the laws of Syracuse.", "lon": -40.933, "lat": -19.841}, {"year": -342, "title": "Hicetas submits", "text": "Besieged at Leontini, Hicetas agrees to give up his fortress and live as a private man.", "lon": -43.972, "lat": -16.832}, {"year": -342, "title": "Raids in the west", "text": "Timoleon's mercenaries plunder Carthage's province; Entella's pro-Carthaginian leaders are executed.", "lon": -64.595, "lat": -10.13}, {"year": -342, "title": "Leptines exiled", "text": "Leptines, tyrant of Apollonia and Engyon, surrenders and is sent to Corinth.", "lon": -48.314, "lat": -7.121}, {"year": -341, "title": "Sicels join", "text": "Sicel towns of the interior turn from the tyrants and Carthage to Timoleon.", "lon": -51.896, "lat": -13.003}, {"year": -340, "title": "Armada at Lilybaeum", "text": "Hasdrubal and Hamilcar land at Lilybaeum with an army the sources put at seventy thousand.", "lon": -71.759, "lat": -9.857}, {"year": -340, "title": "The Sacred Band", "text": "Among them march twenty-five hundred Carthaginian citizens of the Sacred Band, the city's elite.", "lon": -71.325, "lat": -9.583}, {"year": -339, "title": "Mercenaries desert", "text": "On the march west, about a thousand of Timoleon's hired men refuse to go on and turn back.", "lon": -58.083, "lat": -13.276}, {"year": -339, "title": "Crown of celery", "text": "Meeting mules laden with wild celery, the plant of victors' crowns, Timoleon wreathes his head with it.", "lon": -61.339, "lat": -11.908}, {"year": -339, "title": "Storm at the Crimissus", "text": "Timoleon attacks as the Carthaginians cross the river; a storm drives rain and hail into their faces.", "lon": -66.223, "lat": -8.763}, {"year": -339, "title": "Sacred Band destroyed", "text": "Weighed down by armour in mud and flood, the Sacred Band dies where it stands.", "lon": -66.549, "lat": -9.173}, {"year": -339, "title": "Camp plundered", "text": "The victors take the Carthaginian camp, its gold, silver and thousands of shields and breastplates.", "lon": -65.898, "lat": -8.489}, {"year": -339, "title": "Spoils to Corinth", "text": "Timoleon sends the finest arms to Corinth, dedicated for freeing the Greeks of Sicily from Carthage.", "lon": -40.825, "lat": -19.841}, {"year": -339, "title": "Tyrants change sides", "text": "Hicetas and Mamercus ally with Carthage against Timoleon.", "lon": -42.996, "lat": -13.96}, {"year": -339, "title": "Gisgo's mercenaries", "text": "Carthage recalls the exile Gisgo and, for the first time, hires Greek mercenaries.", "lon": -71.759, "lat": -9.994}, {"year": -338, "title": "Hicetas executed", "text": "Defeated by Timoleon, Hicetas is handed over by his own men and put to death.", "lon": -43.972, "lat": -16.696}, {"year": -338, "title": "Peace of the Halycus", "text": "Carthage keeps the west; the Greek cities east of the river Halycus are to be free.", "lon": -62.533, "lat": -15.465}, {"year": -338, "title": "Hippon's end", "text": "Hippon, tyrant of Messana, is caught fleeing by ship and executed by his own citizens.", "lon": -38.003, "lat": -4.523}, {"year": -338, "title": "Mamercus executed", "text": "Mamercus surrenders, is tried before the Syracusan assembly and put to death.", "lon": -40.825, "lat": -19.978}, {"year": -338, "title": "Tyrants of the interior", "text": "Timoleon expels the tyrants of Centuripa and Agyrium.", "lon": -47.446, "lat": -12.045}, {"year": -338, "title": "Akragas refounded", "text": "Colonists from Elea repopulate Akragas, ruined since 406 BC.", "lon": -59.385, "lat": -16.559}, {"year": -338, "title": "Gela resettled", "text": "Settlers from the island of Ceos bring Gela back to life.", "lon": -52.113, "lat": -19.841}, {"year": -338, "title": "Camarina resettled", "text": "New colonists rebuild Camarina on the south coast.", "lon": -49.942, "lat": -22.577}, {"year": -337, "title": "Timoleon steps down", "text": "Timoleon lays down his command and lives on in Syracuse as a private citizen, slowly going blind.", "lon": -40.825, "lat": -19.841}], "eras": [[-345, -345, "Sicily of the Tyrants"], [-344, -343, "The Race for Syracuse"], [-342, -340, "Rebuilding and Raids"], [-339, -339, "The Crimissus"], [-338, -337, "The Peace of the Halycus"]], "refLine": null, "metrics": [{"label": "Carthaginian lands", "stages": [2]}, {"label": "Freed by Timoleon", "stages": [3]}], "chartNote": "Share of the area of Sicily, by the power holding the main cities of each of today's nine provinces, whose boundaries are modern. A simplification: one province could hold a tyrant's city, a free town and Sicel villages at once, and the Halycus frontier ran through Agrigento. Dates follow Diodorus and Plutarch, who differ by a year or two; the Crimissus is dated to 341 or 339 BC.", "chartTitle": "Sicily by power, share of area", "shares": [[0.3592, 0.3487, 0.2921, 0.0, 0.0], [0.3592, 0.2651, 0.2921, 0.0, 0.0837], [0.3592, 0.2651, 0.2921, 0.0837, 0.0], [0.3592, 0.2651, 0.2921, 0.0837, 0.0], [0.3592, 0.2651, 0.2921, 0.0837, 0.0], [0.3592, 0.2651, 0.2921, 0.0837, 0.0], [0.3592, 0.2651, 0.2921, 0.0837, 0.0], [0.0, 0.0, 0.2921, 0.7079, 0.0], [0.0, 0.0, 0.2921, 0.7079, 0.0]], "seaTile": "data:image/svg+xml;base64,", "theme": {"--sea": "#14304A", "--sea-deep": "#0B1D2E", "--shade": "10,20,30", "--neighbor": "#2E4556", "--neighbor-edge": "#5B7385", "--glaze": "#F8F2E8", "--gold": "#B9863F", "--gold-bright": "#DDAE62", "--accent": "#6B1F4E", "--accent-hover": "#842862", "--ink": "#1E1A22", "--ink-muted": "#625A66", "--paper": "#F2EBDF", "--font-display": "'Marcellus', 'Noto Serif', 'DejaVu Serif', 'Noto Sans CJK JP', Georgia, serif", "--font-body": "'Cardo', 'Noto Serif', 'DejaVu Serif', 'Noto Sans CJK JP', Georgia, serif", "--cobalt": "#14304A", "--cobalt-deep": "#0B1D2E", "--wine": "#6B1F4E"}}