lon": -59.126, "lat": -0.404}, {"year": -460, "title": "Site rent ends", "text": "Carthage stops paying the Libyans the yearly rent for its own city site (Justin).", "lon": -58.097, "lat": -1.37}, {"year": -460, "title": "War on the Numidians", "text": "The sons of Hamilcar fight Numidians and Moors on Carthage's frontiers.", "lon": -64.271, "lat": -4.498}, {"year": -450, "title": "The court of 104", "text": "A standing court of judges is set up to keep generals in check.", "lon": -58.097, "lat": -1.37}, {"year": -450, "title": "The Bagradas valley", "text": "Carthage takes the fertile Bagradas (Medjerda) valley; its Libyan farmers owe tribute.", "lon": -62.48, "lat": -1.922}, {"year": -450, "title": "Kerkouane", "text": "The Punic town on Cape Bon flourishes, with purple-dye workshops and houses with baths.", "lon": -55.162, "lat": -0.91}, {"year": -440, "title": "Hadrumetum", "text": "The old Phoenician port keeps its own magistrates as Carthage's ally.", "lon": -56.915, "lat": -6.062}, {"year": -440, "title": "Herodotus' Libyans", "text": "Herodotus describes the farming Maxyes and Gyzantes west of lake Tritonis.", "lon": -65.453, "lat": -15.63}, {"year": -440, "title": "Lotus-eaters' coast", "text": "Greeks place the Lotus-eaters on Djerba and the coast of the Lesser Syrtis.", "lon": -56.077, "lat": -15.354}, {"year": -430, "title": "Thugga", "text": "The Libyan hill town of Thugga falls within Carthage's tribute lands.", "lon": -62.327, "lat": -3.348}, {"year": -410, "title": "Segesta appeals", "text": "The Elymian city of Segesta asks Carthage for help against Selinus.", "lon": -48.569, "lat": 3.644}, {"year": -409, "title": "Selinus falls", "text": "Hannibal Mago storms Selinus after nine days; thousands are killed.", "lon": -48.607, "lat": 1.988}, {"year": -409, "title": "Himera razed", "text": "Hannibal destroys Himera, avenging his grandfather Hamilcar.", "lon": -44.795, "lat": 3.782}, {"year": -406, "title": "Siege of Akragas", "text": "Plague kills Hannibal in camp; Himilco takes the rich Greek city.", "lon": -45.71, "lat": 0.654}, {"year": -405, "title": "Peace of Gela", "text": "Carthage makes peace with Dionysius of Syracuse, keeping western Sicily.", "lon": -43.156, "lat": -0.358}, {"year": -405, "title": "Plague reaches Africa", "text": "Returning soldiers carry plague to Carthage and its Libyan lands.", "lon": -58.097, "lat": -1.37}, {"year": -397, "title": "Motya falls", "text": "Dionysius takes the Phoenician island city of Motya and kills its people.", "lon": -49.941, "lat": 3.322}, {"year": -397, "title": "Lilybaeum founded", "text": "Survivors of Motya settle the new fortress of Lilybaeum.", "lon": -50.055, "lat": 3.0}, {"year": -396, "title": "Siege of Syracuse", "text": "Himilco's huge army besieges Syracuse until plague and a surprise attack destroy it.", "lon": -39.193, "lat": -0.358}, {"year": -396, "title": "Himilco's betrayal", "text": "Himilco buys safe passage home for the citizens, abandoning his Libyan and other allies.", "lon": -58.097, "lat": -1.37}, {"year": -396, "title": "Libyans take Tunes", "text": "Libyan allies and slaves, two hundred thousand by Diodorus' count, seize Tunes.", "lon": -58.669, "lat": -1.6}, {"year": -396, "title": "Carthage besieged", "text": "The rebels camp in the open plain and pin the Carthaginians inside their walls.", "lon": -59.164, "lat": -1.692}, {"year": -396, "title": "Demeter and Kore", "text": "Fearing divine anger, Carthage adopts the Greek cult of Demeter and Kore.", "lon": -58.135, "lat": -1.324}, {"year": -395, "title": "The revolt dissolves", "text": "Fed from Sardinia by sea, Carthage outlasts the leaderless rebels, who quarrel, take bribes and go home.", "lon": -58.669, "lat": -1.6}, {"year": -383, "title": "Battle of Cabala", "text": "Dionysius defeats Mago, who is killed; his son wins back the war at Cronium (dates uncertain).", "lon": -47.921, "lat": 2.77}, {"year": -379, "title": "Plague and revolt", "text": "Plague ravages Carthage; the Libyans break away and Sardinia rebels.", "lon": -61.756, "lat": -4.912}, {"year": -379, "title": "Panic in Carthage", "text": "Terror grips the city; citizens rush armed from their houses at night, believing the enemy inside.", "lon": -58.173, "lat": -1.416}, {"year": -378, "title": "Libyans subdued", "text": "Carthage quickly crushes the Libyans and recovers Sardinia.", "lon": -64.271, "lat": -4.498}, {"year": -368, "title": "Lilybaeum attacked", "text": "Dionysius besieges Lilybaeum in his last war on Carthage.", "lon": -50.055, "lat": 3.0}, {"year": -368, "title": "Suniatus executed", "text": "Hanno's rival is put to death for writing to Dionysius in Greek; Carthage bans Greek lessons.", "lon": -58.135, "lat": -1.324}, {"year": -367, "title": "Hanno's sea victory", "text": "Hanno, with two hundred ships, destroys the Syracusan fleet off Eryx.", "lon": -49.826, "lat": 4.012}, {"year": -350, "title": "The wedding plot", "text": "Hanno the Great plans to poison the council at his daughter's wedding feast (c. 350 BC).", "lon": -58.135, "lat": -1.37}, {"year": -350, "title": "Slaves in arms", "text": "Exposed, Hanno arms slaves, twenty thousand by Justin's count, and seizes an inland fortress.", "lon": -60.879, "lat": -4.13}, {"year": -350, "title": "Call to the Moors", "text": "Hanno appeals to the Africans and the king of the Moors to join him.", "lon": -64.004, "lat": -2.98}, {"year": -349, "title": "Hanno executed", "text": "Captured, Hanno is flogged, blinded and crucified; most of his family is killed.", "lon": -58.135, "lat": -1.37}, {"year": -348, "title": "Treaty with Rome", "text": "A second treaty bars Romans from trading in Libya and Sardinia.", "lon": -58.097, "lat": -1.324}, {"year": -344, "title": "Timoleon arrives", "text": "Corinth sends Timoleon to Sicily; Carthage's war there resumes.", "lon": -39.193, "lat": -0.358}, {"year": -341, "title": "Crimisus River", "text": "Timoleon routs a Carthaginian army; the citizen Sacred Band is destroyed (341 or 339 BC).", "lon": -48.302, "lat": 3.23}, {"year": -340, "title": "Gisco recalled", "text": "Hanno's exiled son Gisco is recalled to command, as Carthage makes peace in Sicily.", "lon": -58.097, "lat": -1.37}], "eras": [[-480, -410, "The Turn to Africa"], [-409, -397, "War in Sicily"], [-396, -380, "The Great Libyan Revolt"], [-379, -361, "Plague and Rebellion"], [-360, -340, "Hanno the Great"]], "refLine": null, "metrics": [{"label": "Carthaginian & allied land", "stages": [2, 3]}, {"label": "Land in revolt", "stages": [4]}], "chartNote": "Share of the area of modern Tunisia, by each present-day governorate's relation to Carthage. Regions are today's boundaries; ancient frontiers were tribal and shifting. This is a simplification: the sources rarely say where each revolt spread, dates of expansion before 400 BC are approximate, and ancient figures for the rebel armies are debated. The vast desert south swings the shares.", "chartTitle": "Carthage's Africa by area", "shares": [[0.9146, 0.0, 0.0836, 0.0018, 0.0], [0.9146, 0.0, 0.0836, 0.0018, 0.0], [0.9146, 0.0, 0.0836, 0.0018, 0.0], [0.9146, 0.0, 0.0836, 0.0018, 0.0], [0.9146, 0.0, 0.0836, 0.0018, 0.0], [0.9146, 0.0, 0.0836, 0.0018, 0.0], [0.9146, 0.0, 0.0836, 0.0018, 0.0], [0.9146, 0.0, 0.0836, 0.0018, 0.0], [0.9146, 0.0, 0.0836, 0.0018, 0.0], [0.9146, 0.0, 0.0836, 0.0018, 0.0], [0.9146, 0.0, 0.0836, 0.0018, 0.0], [0.9146, 0.0, 0.0836, 0.0018, 0.0], [0.9146, 0.0, 0.0836, 0.0018, 0.0], [0.9146, 0.0, 0.0836, 0.0018, 0.0], [0.9146, 0.0, 0.0836, 0.0018, 0.0], [0.9146, 0.0, 0.0836, 0.0018, 0.0], [0.9146, 0.0, 0.0836, 0.0018, 0.0], [0.9146, 0.0, 0.0836, 0.0018, 0.0], [0.9146, 0.0, 0.0836, 0.0018, 0.0], [0.9146, 0.0, 0.0836, 0.0018, 0.0], [0.881, 0.0, 0.0836, 0.0353, 0.0], [0.881, 0.0, 0.0836, 0.0353, 0.0], [0.881, 0.0, 0.0836, 0.0353, 0.0], [0.881, 0.0, 0.0836, 0.0353, 0.0], [0.881, 0.0, 0.0836, 0.0353, 0.0], [0.881, 0.0, 0.0836, 0.0353, 0.0], [0.881, 0.0, 0.0836, 0.0353, 0.0], [0.881, 0.0, 0.0836, 0.0353, 0.0], [0.881, 0.0, 0.