8,9.294L-49.143,9.434L-49.526,9.945L-49.902,10.099L-50.017,10.533L-50.17,10.637L-50.69,10.771L-50.907,11.13L-51.276,11.175L-51.443,11.38L-51.934,11.608L-52.317,12.3L-52.43,12.368L-52.363,12.846L-52.16,13.469L-51.786,14.009L-51.104,14.663L-50.456,14.937L-49.866,14.807L-49.529,14.643L-49.434,14.817L-49.446,15.154L-49.632,15.285L-49.703,15.435L-49.582,15.678L-49.441,15.766L-48.743,15.464L-48.648,15.295L-48.755,15.087L-48.634,14.99L-48.534,15.032L-48.436,14.956L-48.199,15.08L-47.919,15.462L-47.898,15.708L-48.007,15.883L-47.922,16.184L-47.958,16.325L-47.839,16.289L-47.678,16.484L-47.176,16.704L-47.232,16.738L-47.829,16.584L-47.877,16.738L-47.642,17.076L-47.373,17.042L-46.856,17.21L-46.608,17.162L-46.939,16.841L-46.314,17.222L-46.512,18.592L-46.483,19.1L-46.539,19.887L-46.456,20.077L-46.088,20.527L-46.074,20.733L-46.146,20.887L-46.563,21.209L-48.891,22.346L-49.002,22.469L-49.166,22.858ZM-48.51,14.528L-48.55,14.688L-48.55,14.518L-48.614,14.539L-48.831,14.971L-48.899,14.901L-48.876,14.735L-49.082,14.531L-49.153,14.509L-49.338,14.676L-49.433,14.601L-49.483,14.392L-49.403,14.124L-49.45,13.771L-49.299,13.714L-48.79,13.797L-48.659,13.714L-48.128,14.183L-48.51,14.528ZM-48.147,10.159L-48.52,9.984L-48.426,9.91L-47.961,9.914L-47.922,9.97L-48.147,10.159ZM-47.751,9.738L-47.668,9.487L-47.566,9.556L-47.468,9.538L-47.487,9.371L-47.337,9.154L-47.153,9.211L-47.134,9.255L-47.24,9.292L-47.29,9.412L-47.131,9.564L-47.163,9.631L-47.841,9.952L-47.875,9.868L-47.751,9.738Z", "events": [{"year": -146, "title": "Carthage burns", "text": "After a three-year siege, Scipio Aemilianus storms Carthage; the city burns for days and is razed.", "lon": -51.134, "lat": 0.791}, {"year": -146, "title": "Scipio's tears", "text": "Polybius, at his side, records that Scipio wept and quoted Homer on the fall of Troy, fearing for Rome.", "lon": -51.105, "lat": 0.825}, {"year": -146, "title": "Enslaved survivors", "text": "About fifty thousand men, women and children who surrendered on the Byrsa are sold into slavery.", "lon": -51.146, "lat": 0.776}, {"year": -146, "title": "A curse on the site", "text": "Ten senators decree that no one may live there and lay a curse on anyone who rebuilds Byrsa or Megara.", "lon": -51.065, "lat": 0.825}, {"year": -146, "title": "Province of Africa", "text": "Carthage's remaining lands become the Roman province of Africa, governed from Utica.", "lon": -52.218, "lat": 1.786}, {"year": -146, "title": "Free cities rewarded", "text": "Hadrumetum, Leptis Minor, Thapsus, Acholla and other towns that sided with Rome stay free.", "lon": -49.841, "lat": -4.228}, {"year": -146, "title": "The Fossa Regia", "text": "A royal ditch is marked from Thabraca to Thaenae, between the province and the Numidian kingdom.", "lon": -57.507, "lat": 1.266}, {"year": -146, "title": "Mago's farming manual", "text": "The Senate has the Carthaginian Mago's treatise on agriculture translated into Latin.", "lon": -51.228, "lat": 0.727}, {"year": -139, "title": "Massinissa's temple", "text": "Thugga dedicates a temple to the late King Massinissa, with a Libyan and Punic inscription.", "lon": -55.631, "lat": -1.334}, {"year": -125, "title": "Locusts and plague", "text": "Swarms of locusts and an epidemic strike the province; Orosius claims enormous death tolls.", "lon": -52.206, "lat": 1.512}, {"year": -123, "title": "The Rubrian law", "text": "A tribune's law, backed by Gaius Gracchus, orders a colony for poor citizens at Carthage.", "lon": -51.309, "lat": 0.678}, {"year": -122, "title": "Colonia Junonia", "text": "Gracchus spends seventy days in Africa laying out a colony of six thousand settlers.", "lon": -51.432, "lat": 0.531}, {"year": -122, "title": "Wolves and omens", "text": "Ancient writers report that wolves tore up the colony's boundary markers, a dire omen.", "lon": -51.554, "lat": 0.285}, {"year": -121, "title": "Colony annulled", "text": "After Gracchus is killed in Rome, the Senate abolishes the colony; its settlers keep their land.", "lon": -51.228, "lat": 0.531}, {"year": -111, "title": "Land law of 111", "text": "A Roman agrarian law confirms the settlers' plots and lists the land of the free cities.", "lon": -51.635, "lat": 0.138}, {"year": -111, "title": "War with Jugurtha", "text": "After Jugurtha's men massacre Italian traders at Cirta, a consular army lands in the province to fight him.", "lon": -52.206, "lat": 1.708}, {"year": -109, "title": "Metellus advances", "text": "The consul Metellus marches into Numidia and garrisons the market town of Vaga.", "lon": -55.794, "lat": 0.187}, {"year": -108, "title": "Massacre at Vaga", "text": "Vaga's citizens kill the Roman garrison during a festival; Metellus retakes the town two days later.", "lon": -55.835, "lat": 0.236}, {"year": -108, "title": "Thala taken", "text": "Metellus storms Thala, where Jugurtha kept his treasure; its defenders burn themselves inside.", "lon": -57.874, "lat": -5.504}, {"year": -107, "title": "Capsa destroyed", "text": "Marius takes the oasis town of Capsa by surprise, kills its men and burns it despite its surrender.", "lon": -57.425, "lat": -11.145}, {"year": -103, "title": "Marius' veterans", "text": "A law of Saturninus gives Marius' veterans farms in Africa, around Thibaris and Uchi Maius.", "lon": -55.835, "lat": -1.039}, {"year": -88, "title": "Marius in the ruins", "text": "Banished by Sulla, Marius lands at Carthage: 'tell him you saw Marius sitting among the ruins'.", "lon": -51.187, "lat": 0.776}, {"year": -81, "title": "Pompey in Africa", "text": "The young Pompey crushes the Marians and King Hiarbas, restores Hiempsal II and is hailed 'Magnus'.", "lon": -52.206, "lat": 1.708}, {"year": -49, "title": "Curio's defeat", "text": "Caesar's general Curio is destroyed by King Juba of Numidia on the Bagradas river near Utica.", "lon": -52.369, "lat": 1.414}, {"year": -47, "title": "Caesar lands", "text": "Caesar lands near Hadrumetum with a small army to fight the republicans and Juba.", "lon": -49.923, "lat": -4.179}, {"year": -46, "title": "Battle of Ruspina", "text": "Caesar's outnumbered army narrowly escapes encirclement by Labienus' cavalry.", "lon": -49.067, "lat": -4.522}, {"year": -46, "title": "Battle of Thapsus", "text": "On 6 April Caesar routs Scipio and Juba; thousands of surrendering soldiers are cut down.", "lon": -48.17, "lat": -5.258}, {"year": -46, "title": "Cato at Utica", "text": "Refusing Caesar's mercy, Cato the Younger takes his own life in Utica.", "lon": -52.218, "lat": 1.757}, {"year": -46, "title": "Juba's end", "text": "Shut out of his own capital, Juba dies in a suicide pact with the Roman general Petreius.", "lon": -54.816, "lat": -3.247}, {"year": -46, "title": "Africa Nova", "text": "Caesar annexes Juba's kingdom as the province of Africa Nova; the historian Sallust governs it.", "lon": -55.713, "lat": -4.081}, {"year": -46, "title": "Cities fined", "text": "Caesar fines Thysdrus, Hadrumetum and others that backed his enemies.", "lon": -49.556, "lat": -6.828}, {"year": -46, "title": "Caesar's dream", "text": "Appian tells that Caesar, camped by the ruins, dreamt of an army weeping and resolved to refound Carthage.", "lon": -51.146, "lat": 0.727}, {"year": -45, "title": "Colony at Curubis", "text": "Curubis on Cap Bon becomes a Roman colony and builds new walls.", "lon": -48.944, "lat": -0.598}, {"year": -44, "title": "Caesar's colony", "text": "Settlers begin to return to Carthage under Caesar's plan, weeks before his murder in Rome.", "lon": -51.146, "lat": 0.825}, {"year": -40, "title": "Lepidus governs Africa", "text": "The triumvir Lepidus rules Africa; part of the young colony at Carthage is laid waste.", "lon": -52.206, "lat": 1.806}, {"year": -36, "title": "Lepidus sails", "text": "Lepidus leaves Africa with his legions for Sicily, where Octavian strips him of power.", "lon": -51.105, "lat": 0.531}, {"year": -30, "title": "Veteran colonies", "text": "Veterans settle at Uthina, Thuburbo Minus and Hippo Diarrhytus around the Gulf.", "lon": -51.758, "lat": -0.353}, {"year": -29, "title": "Carthage refounded", "text": "Octavian founds Colonia Iulia Concordia Carthago with three thousand colonists from Italy.", "lon": -51.134, "lat": 0.791}, {"year": -29, "title": "Byrsa levelled", "text": "Builders cut down the Byrsa hilltop and bury Punic houses to make a platform for the forum.", "lon": -51.146, "lat": 0.791}, {"year": -29, "title": "A new street grid", "text": "Streets and the farmland around the city are laid out on a single Roman grid.", "lon": -51.269, "lat": 0.825}], "eras": [[-146, -124, "The Cursed Ground"], [-123, -112, "The Gracchan Colony"], [-111, -105, "The Jugurthine War"], [-104, -50, "Marius, Sulla and Pompey"], [-49, -44, "Caesar in Africa"], [-43, -29, "Augustus' Carthage"]], "refLine": null, "metrics": [{"label": "Roman Africa", "stages": [2, 3, 4, 5]}, {"label": "Numidian kingdom", "stages": [1]}], "chartNote": "Share of the area of modern Tunisia, by the power that held most of each present-day governorate. Regions are today's boundaries; the ancient frontiers, such as the Fossa Regia, cut across them and are known only in part, and the desert south swings the shares. A simplification: dates mark turning points.", "chartTitle": "Who held Tunisia, by area", "shares": [[0.4406, 0.3529, 0.2048, 0.0, 0.0018, 0.0], [0.4406, 0.3529, 0.2048, 0.0, 0.0018, 0.0], [0.4406, 0.3529, 0.2048, 0.0, 0.0018, 0.0], [0.4406, 0.3529, 0.2048, 0.0, 0.0018, 0.0], [0.4406, 0.3529, 0.2048, 0.0, 0.0018, 0.0], [0.4406, 0.3529, 0.2048, 0.0, 0.0018, 0.0], [0.4406, 0.3529, 0.2048, 0.0, 0.0018, 0.0], [0.4406, 0.3529, 0.2048, 0.0, 0.0018, 0.0], [0.4406, 0.3529, 0.2048, 0.0, 0.0018, 0.0], [0.4406, 0.3529, 0.2048, 0.0, 0.0018, 0.0], [0.4406, 0.3529, 0.2048, 0.0, 0.0018, 0.0], [0.4406, 0.3529, 0.2048, 0.0, 0.0018, 0.0], [0.4406, 0.3529, 0.2048, 0.0, 0.0018, 0.0], [0.4406, 0.3529, 0.2048, 0.0, 0.0018, 0.0], [0.4406, 0.3529, 0.2048, 0.0, 0.0018, 0.0], [0.4406, 0.3529, 0.2048, 0.0, 0.0018, 0.0], [0.4406, 0.3529, 0.2048, 0.0, 0.0018, 0.0], [0.