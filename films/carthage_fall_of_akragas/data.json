21.838L-50.481,21.436L-51.516,20.42L-52.315,19.889L-53.249,19.444L-53.677,19.365L-54.953,19.471ZM-73.521,7.976L-73.839,7.804L-74.004,7.89L-74.139,7.857L-74.305,7.599L-74.148,7.613L-73.839,7.502L-73.582,7.692L-73.218,7.804L-73.345,7.964L-73.521,7.976ZM-76.676,6.931L-76.508,7.446L-76.673,7.437L-76.868,7.295L-77.063,6.957L-77,6.862L-76.8,6.842L-76.676,6.931ZM-64.123,-3.536L-63.936,-3.539L-63.803,-3.408L-64.038,-3.189L-64.169,-3.161L-64.302,-3.214L-64.307,-3.321L-64.123,-3.536ZM-43.79,0.535L-43.705,0.535L-43.705,0.739L-43.394,0.963L-43.238,1.326L-43.472,1.521L-43.91,1.058L-43.943,0.831L-43.79,0.535ZM-43.86,-0.159L-43.705,0.242L-43.904,0.278L-44.465,-0.163L-44.451,-0.406L-44.348,-0.644L-44.176,-0.745L-43.801,-0.741L-43.707,-0.658L-43.79,-0.452L-43.557,-0.247L-43.557,-0.159L-43.86,-0.159ZM-50.748,-0.928L-50.789,-1.102L-50.626,-1.158L-50.584,-0.984L-50.748,-0.928ZM-44.894,-0.988L-45.322,-1.167L-45.665,-1.45L-45.424,-1.625L-45.01,-1.641L-44.834,-1.586L-44.72,-1.42L-44.894,-0.988ZM-48.139,-1.522L-48.032,-1.247L-48.167,-1.235L-48.417,-1.307L-48.52,-1.669L-48.276,-1.635L-48.139,-1.522ZM-41.197,-4.563L-40.838,-4.891L-40.603,-4.778L-40.712,-4.477L-40.851,-4.334L-40.98,-4.365L-41.197,-4.563Z", "events": [{"year": -410, "title": "Segesta appeals", "text": "At war with Selinus over borderland, the Elymian city of Segesta places itself under Carthage's protection.", "lon": -67.978, "lat": -7.593}, {"year": -410, "title": "Hannibal chosen", "text": "Carthage names Hannibal, grandson of the Hamilcar killed at Himera in 480, as its general.", "lon": -72.069, "lat": -8.595}, {"year": -410, "title": "First force lands", "text": "Hannibal sends 5,000 Libyans and 800 Campanian mercenaries, who rout a Selinuntine army near Segesta.", "lon": -67.183, "lat": -8.452}, {"year": -410, "title": "Selinus asks Syracuse", "text": "Selinus appeals to Syracuse; Syracuse, still exhausted after Athens' invasion, promises help but delays.", "lon": -40.027, "lat": -20.048}, {"year": -410, "title": "Phoenician Motya", "text": "Carthage's island city in the western lagoon, its oldest foothold in Sicily, prepares to receive an army.", "lon": -72.069, "lat": -8.595}, {"year": -409, "title": "Landing at Lilybaeum", "text": "Hannibal crosses with 60 warships and some 1,500 transports and lands at Cape Lilybaeum.", "lon": -72.523, "lat": -9.597}, {"year": -409, "title": "Fleet beached at Motya", "text": "The warships are drawn up in the bay around Motya while the army marches south-east.", "lon": -71.728, "lat": -8.881}, {"year": -409, "title": "Selinus besieged", "text": "Six siege towers and iron-headed rams batter walls left neglected through years of peace.", "lon": -67.978, "lat": -12.747}, {"year": -409, "title": "Selinus falls", "text": "On the ninth day the attackers break in; about 16,000 are killed and more than 5,000 captured.", "lon": -68.092, "lat": -12.604}, {"year": -409, "title": "Survivors reach Akragas", "text": "Some 2,600 Selinuntines escape east and find refuge at Akragas.", "lon": -59.343, "lat": -16.755}, {"year": -409, "title": "March on Himera", "text": "Hannibal crosses the island to Himera, the city where his grandfather died.", "lon": -56.729, "lat": -7.163}, {"year": -409, "title": "Diocles arrives", "text": "The Syracusan Diocles brings about 4,000 men; a sortie kills thousands of besiegers but is driven back.", "lon": -56.616, "lat": -7.306}, {"year": -409, "title": "Diocles abandons Himera", "text": "Fearing a strike on Syracuse, Diocles withdraws, taking half the townspeople with him by sea and land.", "lon": -56.275, "lat": -7.449}, {"year": -409, "title": "Himera destroyed", "text": "The city falls; its temples are burned and its walls razed after some 240 years.", "lon": -56.729, "lat": -7.02}, {"year": -409, "title": "3,000 prisoners killed", "text": "Hannibal has about 3,000 captives tortured and killed at the place where Hamilcar fell in 480.", "lon": -56.843, "lat": -7.163}, {"year": -409, "title": "Hannibal sails home", "text": "With the army disbanded to its cities, Hannibal returns to Carthage in triumph.", "lon": -72.069, "lat": -8.595}, {"year": -408, "title": "Hermocrates at Selinus", "text": "The exiled Syracusan general occupies the ruins of Selinus and walls part of the city.", "lon": -67.978, "lat": -12.747}, {"year": -408, "title": "Raids on Motya", "text": "Hermocrates gathers some 6,000 men and plunders the territory of Motya.", "lon": -71.16, "lat": -9.167}, {"year": -408, "title": "Raids on Panormus", "text": "His men defeat the Panormitans in the field, killing about 500.", "lon": -61.956, "lat": -5.015}, {"year": -408, "title": "Bones of Himera", "text": "Hermocrates gathers the bones of the Syracusan dead at Himera and sends them home on wagons.", "lon": -56.729, "lat": -7.163}, {"year": -407, "title": "Hermocrates killed", "text": "Trying to force his way back into Syracuse, Hermocrates is killed in the market-place; young Dionysius is wounded.", "lon": -40.027, "lat": -20.048}, {"year": -407, "title": "Thermai founded", "text": "Carthage settles citizens and Libyans at the hot springs beside Himera's ruins.", "lon": -58.093, "lat": -7.02}, {"year": -407, "title": "Carthage rearms", "text": "Hannibal and his kinsman Himilco hire Iberian, Balearic and Campanian mercenaries for a greater war.", "lon": -72.069, "lat": -8.595}, {"year": -407, "title": "Sea fight off Eryx", "text": "A Syracusan squadron sinks fifteen Carthaginian ships near Eryx; Hannibal answers with fifty more.", "lon": -70.705, "lat": -6.161}, {"year": -406, "title": "Akragas besieged", "text": "A vast army camps before Akragas; Ephorus claims 300,000 men, Timaeus about 120,000.", "lon": -59.456, "lat": -16.899}, {"year": -406, "title": "Dexippus the Spartan", "text": "The Spartan Dexippus arrives from Gela with 1,500 mercenaries to help defend the city.", "lon": -59.229, "lat": -16.612}, {"year": -406, "title": "Tombs torn down", "text": "To build siege ramps, Hannibal orders the city's tombs demolished; lightning strikes the tomb of Theron.", "lon": -59.57, "lat": -17.042}, {"year": -406, "title": "Plague kills Hannibal", "text": "Disease sweeps the crowded camp and kills Hannibal; Himilco takes command.", "lon": -59.797, "lat": -17.185}, {"year": -406, "title": "Himilco's sacrifice", "text": "To end the plague, Himilco sacrifices a boy to Baal Hammon and drowns cattle for the sea god.", "lon": -59.684, "lat": -17.328}, {"year": -406, "title": "Battle of the Himeras", "text": "Daphnaeus' Syracusan relief army defeats the Carthaginians by the river Himeras, killing about 6,000.", "lon": -56.957, "lat": -18.187}, {"year": -406, "title": "Generals stoned", "text": "Akragantines stone four of their own generals for letting the beaten enemy escape.", "lon": -59.343, "lat": -16.612}, {"year": -406, "title": "Grain convoy lost", "text": "Himilco's ships capture a Syracusan grain convoy; hunger now grips the besieged.", "lon": -61.502, "lat": -18.903}, {"year": -406, "title": "Mercenaries desert", "text": "Bribed with fifteen talents, the Campanian mercenaries go over to Carthage.", "lon": -59.115, "lat": -16.755}, {"year": -406, "title": "Akragas abandoned", "text": "Near the winter solstice, the people flee by night towards Gela; those left behind are killed.", "lon": -59.343, "lat": -16.612}, {"year": -406, "title": "Tellias' last stand", "text": "The rich citizen Tellias sets fire to the temple of Athena and dies with its treasures.", "lon": -59.343, "lat": -16.469}, {"year": -406, "title": "The march to Gela", "text": "Old men, women and children walk some seventy kilometres east to Gela; many later settle at Leontini.", "lon": -54.684, "lat": -18.903}, {"year": -405, "title": "Dionysius takes power", "text": "Blaming the generals, the young Dionysius is made general with full powers and a bodyguard of 600.", "lon": -40.027, "lat": -20.048}, {"year": -405, "title": "Akragas razed", "text": "At the start of summer Himilco destroys the city and defaces its temples; the bull of Phalaris goes to Carthage.", "lon": -59.456, "lat": -16.899}, {"year": -405, "title": "Gela besieged", "text": "Himilco's army moves east; Gela's walls hold while Dionysius gathers 30,000 infantry and 50 ships.", "lon": -51.844, "lat": -20.048}, {"year": -405, "title": "Defeat at Gela", "text": "Dionysius' three-pronged attack fails; he evacuates Gela by night.", "lon": -51.957, "lat": -19.905}, {"year": -405, "title": "Camarina emptied", "text": "Dionysius orders Camarina abandoned; its people stream along the coast towards Syracuse.", "lon": -49.571, "lat": -22.912}, {"year": -405, "title": "Cavalry revolt", "text": "Syracusan horsemen plunder Dionysius' house and abuse his wife; he rides through the night and crushes them.", "lon": -40.254, "lat": -20.192}, {"year": -405, "title": "Peace of 405", "text": "Plague-stricken, Himilco makes peace: Carthage rules the west and south, and Dionysius keeps Syracuse.", "lon": -43.322, "lat": -16.899}], "eras": [[-410, -410, "Segesta's Appeal"], [-409, -409, "Hannibal's Revenge"], [-408, -407, "Hermocrates and the Uneasy Truce"], [-406, -406, "The Siege of Akragas"], [-405, -405, "Gela, Dionysius and the Peace"]], "refLine": null, "metrics": [{"label": "Under Carthage", "stages": [3]}, {"label": "Sacked or abandoned", "stages": [4]}], "chartNote": "Share of the area of present-day Sicily, by the fate of the leading city in each of today's nine provinces, a simplification: ancient territories did not follow these boundaries, and most provinces held Greek, Phoenician, Elymian and Sicel communities at once. Dates follow Diodorus.", "chartTitle": "Sicily by area, under whose control", "shares": [[0.0988, 0.6215, 0.0837, 0.196, 0.0], [0.0988, 0.5254, 0.0837, 0.196, 0.0961], [0.0988, 0.5254, 0.0837, 0.196, 0.0961], [0.0988, 0.5254, 0.0837, 0.196, 0.0961], [0.0988, 0.4093, 0.0837, 0.196, 0.2122], [0.0988, 0.2651, 0.0837, 0.5524, 0.0]], "seaTile": "data:image/svg+xml;base64,", "theme": {"--sea": "#14304A", "--sea-deep": "#0B1D2E", "--shade": "10,20,30", "--neighbor": "#2E4556", "--neighbor-edge": "#5B7385", "--glaze": "#F8F2E8", "--gold": "#B9863F", "--gold-bright": "#DDAE62", "--accent": "#6B1F4E", "--accent-hover": "#842862", "--ink": "#1E1A22", "--ink-muted": "#625A66", "--paper": "#F2EBDF", "--font-display": "'Marcellus', 'Noto Serif', 'DejaVu Serif', 'Noto Sans CJK JP', Georgia, serif", "--font-body": "'Cardo', 'Noto Serif', 'DejaVu Serif', 'Noto Sans CJK JP', Georgia, serif", "--cobalt": "#14304A", "--cobalt-deep": "#0B1D2E", "--wine": "#6B1F4E"}}