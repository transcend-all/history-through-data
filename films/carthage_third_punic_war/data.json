509L-48.715,8.92L-48.96,9.129L-48.898,9.294L-49.143,9.434L-49.526,9.945L-49.902,10.099L-50.017,10.533L-50.17,10.637L-50.69,10.771L-50.907,11.13L-51.276,11.175L-51.443,11.38L-51.934,11.608L-52.317,12.3L-52.43,12.368L-52.363,12.846L-52.16,13.469L-51.786,14.009L-51.104,14.663L-50.456,14.937L-49.866,14.807L-49.529,14.643L-49.434,14.817L-49.446,15.154L-49.632,15.285L-49.703,15.435L-49.582,15.678L-49.441,15.766L-48.743,15.464L-48.648,15.295L-48.755,15.087L-48.634,14.99L-48.534,15.032L-48.436,14.956L-48.199,15.08L-47.919,15.462L-47.898,15.708L-48.007,15.883L-47.922,16.184L-47.958,16.325L-47.839,16.289L-47.678,16.484L-47.176,16.704L-47.232,16.738L-47.829,16.584L-47.877,16.738L-47.642,17.076L-47.373,17.042L-46.856,17.21L-46.608,17.162L-46.939,16.841L-46.314,17.222L-46.512,18.592L-46.483,19.1L-46.539,19.887L-46.456,20.077L-46.088,20.527L-46.074,20.733L-46.146,20.887L-46.563,21.209L-48.891,22.346L-49.002,22.469L-49.166,22.858ZM-48.51,14.528L-48.55,14.688L-48.55,14.518L-48.614,14.539L-48.831,14.971L-48.899,14.901L-48.876,14.735L-49.082,14.531L-49.153,14.509L-49.338,14.676L-49.433,14.601L-49.483,14.392L-49.403,14.124L-49.45,13.771L-49.299,13.714L-48.79,13.797L-48.659,13.714L-48.128,14.183L-48.51,14.528ZM-48.147,10.159L-48.52,9.984L-48.426,9.91L-47.961,9.914L-47.922,9.97L-48.147,10.159ZM-47.751,9.738L-47.668,9.487L-47.566,9.556L-47.468,9.538L-47.487,9.371L-47.337,9.154L-47.153,9.211L-47.134,9.255L-47.24,9.292L-47.29,9.412L-47.131,9.564L-47.163,9.631L-47.841,9.952L-47.875,9.868L-47.751,9.738Z", "events": [{"year": -201, "title": "Peace after Zama", "text": "Carthage surrenders its fleet and elephants, owes ten thousand talents over fifty years, and may wage no war without Rome's consent.", "lon": -51.146, "lat": 0.776}, {"year": -201, "title": "Masinissa's reward", "text": "Rome confirms Masinissa as king of Numidia, with a vague right to reclaim the lands of his ancestors.", "lon": -57.711, "lat": -2.511}, {"year": -196, "title": "Hannibal as suffete", "text": "Elected chief magistrate, Hannibal curbs the oligarchs and reforms Carthage's finances.", "lon": -51.228, "lat": 0.825}, {"year": -195, "title": "Hannibal's flight", "text": "Denounced to Rome by his enemies, Hannibal escapes by sea and joins Antiochus III.", "lon": -48.17, "lat": -5.258}, {"year": -193, "title": "The Emporia raided", "text": "Masinissa raids the trading towns of the Lesser Syrtis; Scipio Africanus's commission leaves the dispute unresolved.", "lon": -52.043, "lat": -13.794}, {"year": -191, "title": "Early payment refused", "text": "Carthage offers to pay its whole remaining indemnity at once; Rome refuses.", "lon": -51.065, "lat": 0.727}, {"year": -191, "title": "Grain for Rome", "text": "Carthage ships grain to Roman armies fighting in the East, as it will again in 171.", "lon": -51.105, "lat": 0.629}, {"year": -182, "title": "A border dispute", "text": "Carthage complains to Rome that Masinissa has seized its land; Rome lets the matter lapse.", "lon": -55.713, "lat": 0.187}, {"year": -172, "title": "Seventy towns", "text": "Carthaginian envoys tell the Senate Masinissa has taken more than seventy towns and forts in two years.", "lon": -55.713, "lat": -4.081}, {"year": -161, "title": "The Emporia lost", "text": "Roman arbiters award the Emporia to Masinissa and order Carthage to pay him five hundred talents.", "lon": -48.822, "lat": -15.511}, {"year": -153, "title": "The Great Plains", "text": "Masinissa seizes the Great Plains of the Bagradas valley.", "lon": -57.14, "lat": -0.941}, {"year": -153, "title": "Tusca taken", "text": "The district of Tusca and its fifty towns, around Thugga, pass to Numidia.", "lon": -55.631, "lat": -1.334}, {"year": -153, "title": "Cato's embassy", "text": "Cato, sent to arbitrate, finds Carthage prosperous and full of young men and returns convinced it must go.", "lon": -51.146, "lat": 0.825}, {"year": -152, "title": "Cato's figs", "text": "Cato shows the Senate fresh figs picked in Carthage three days before: the enemy is that close.", "lon": -51.187, "lat": 0.874}, {"year": -152, "title": "Carthago delenda est", "text": "Cato ends his speeches, whatever their subject, by declaring that Carthage must be destroyed; Scipio Nasica answers that it must be spared.", "lon": -51.105, "lat": 0.923}, {"year": -151, "title": "Indemnity paid", "text": "Carthage makes the last payment of its fifty-year war indemnity.", "lon": -51.146, "lat": 0.727}, {"year": -150, "title": "Numidians expelled", "text": "Carthage exiles Masinissa's partisans and bars his sons from the city.", "lon": -51.187, "lat": 0.776}, {"year": -150, "title": "War with Numidia", "text": "Hasdrubal marches west with some twenty-five thousand men against the eighty-eight-year-old king.", "lon": -56.12, "lat": -1.922}, {"year": -150, "title": "Army starved", "text": "Trapped and starving, the Carthaginian army surrenders and is cut down by Numidian horsemen; Scipio Aemilianus watches.", "lon": -56.528, "lat": -1.432}, {"year": -149, "title": "Utica defects", "text": "Carthage's oldest neighbour goes over to Rome and offers its harbour as a base.", "lon": -52.206, "lat": 1.806}, {"year": -149, "title": "Rome declares war", "text": "Some eighty thousand Roman infantry and four thousand horse land at Utica under the consuls Manilius and Censorinus.", "lon": -52.288, "lat": 1.708}, {"year": -149, "title": "Three hundred hostages", "text": "Carthage sends three hundred children of its leading families to the Romans in Sicily.", "lon": -50.983, "lat": 0.776}, {"year": -149, "title": "Disarmed", "text": "Carthage hands over some two hundred thousand sets of armour and two thousand catapults.", "lon": -52.125, "lat": 1.61}, {"year": -149, "title": "Leave the sea", "text": "The consuls order the people to abandon their city and resettle ten miles inland; Carthage refuses.", "lon": -51.146, "lat": 0.776}, {"year": -149, "title": "The city rearms", "text": "Slaves are freed, temples become workshops and women give their hair for catapult cords.", "lon": -51.105, "lat": 0.825}, {"year": -149, "title": "Fleet burned", "text": "Fire ships drift into the Roman fleet moored on the lake of Tunis.", "lon": -51.472, "lat": 0.531}, {"year": -149, "title": "Masinissa dies", "text": "The king dies at about ninety; Scipio Aemilianus divides his kingdom between three sons. Cato also dies this year.", "lon": -58.159, "lat": -1.922}, {"year": -148, "title": "Phameas defects", "text": "Himilco Phameas, Carthage's best cavalry leader, goes over to Scipio with twenty-two hundred horse.", "lon": -51.635, "lat": -0.205}, {"year": -148, "title": "Hippo holds", "text": "The consul Piso fails to take Hippo Diarrhytus on the north coast.", "lon": -52.981, "lat": 2.836}, {"year": -148, "title": "Neapolis sacked", "text": "Piso plunders Neapolis after its surrender and is repulsed from Aspis.", "lon": -49.475, "lat": -1.186}, {"year": -147, "title": "Scipio consul", "text": "Under the legal age, Scipio Aemilianus is elected consul and given the African command.", "lon": -51.146, "lat": 0.972}, {"year": -147, "title": "The isthmus walled", "text": "Scipio fortifies a camp across the isthmus, cutting Carthage off by land.", "lon": -51.432, "lat": 0.825}, {"year": -147, "title": "The mole", "text": "Roman troops build a stone mole across the harbour mouth to starve the city.", "lon": -51.065, "lat": 0.678}, {"year": -147, "title": "A new channel", "text": "The Carthaginians secretly dig a new exit to the sea and sail out a hastily built fleet.", "lon": -51.105, "lat": 0.727}, {"year": -146, "title": "Nepheris falls", "text": "The fortress south of the lake falls, and the countryside's last aid to Carthage ends.", "lon": -51.105, "lat": -0.353}, {"year": -146, "title": "Harbours stormed", "text": "In spring Laelius takes the round naval harbour and the Romans reach the agora.", "lon": -51.146, "lat": 0.727}, {"year": -146, "title": "Six days of fighting", "text": "Romans fight house by house up three streets to the Byrsa, burning as they go.", "lon": -51.138, "lat": 0.781}, {"year": -146, "title": "Byrsa surrenders", "text": "About fifty thousand men and women come down from the citadel and are sold as slaves.", "lon": -51.134, "lat": 0.791}, {"year": -146, "title": "Temple of Eshmoun", "text": "Hasdrubal surrenders; Roman deserters set fire to the temple, and his wife dies in the flames with her children.", "lon": -51.126, "lat": 0.8}, {"year": -146, "title": "Scipio's tears", "text": "Watching the city burn, Scipio quotes Homer on the fall of Troy and fears for Rome, Polybius records.", "lon": -51.228, "lat": 0.727}, {"year": -146, "title": "Carthage levelled", "text": "A senatorial commission razes what remains and curses the site; no one may live there.", "lon": -51.187, "lat": 0.776}, {"year": -146, "title": "No salt", "text": "No ancient source says the Romans salted the earth; the story first appears in modern books.", "lon": -51.269, "lat": 0.825}, {"year": -146, "title": "Province of Africa", "text": "Rome annexes Carthage's last lands as Africa, governed from Utica and bounded by the King's Ditch.", "lon": -52.206, "lat": 1.806}, {"year": -146, "title": "Free cities", "text": "Utica, Hadrumetum, Leptis Minor, Thapsus and Acholla, which sided with Rome, are left free.", "lon": -49.841, "lat": -4.228}], "eras": [[-201, -194, "The Peace of Zama"], [-193, -154, "Masinissa's Advance"], [-153, -150, "Carthago Delenda Est"], [-149, -148, "The Siege Begins"], [-147, -146, "Scipio Aemilianus"]], "refLine": null, "metrics": [{"label": "Carthaginian lands", "stages": [1, 4]}, {"label": "Roman lands", "stages": [3, 5]}], "chartNote": "Share of the area of modern Tunisia, by who held most of each present-day governorate. Regions are today's boundaries; ancient borders are known only roughly, and the sources date Masinissa's seizures loosely, so the map is a simplification. The vast desert south swings the shares.", "chartTitle": "Who held today's Tunisia", "shares": [[0.622, 0.378, 0.0, 0.0, 0.0, 0.0], 