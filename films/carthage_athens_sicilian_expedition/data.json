8L-34.948,4.554L-34.818,4.618L-34.396,4.629L-34.272,4.56L-34.236,4.389L-34.466,4.092L-34.475,3.871L-34.356,3.624L-34.177,3.58L-33.973,3.758L-33.985,4.014L-33.809,4.057L-33.326,4.368L-33.098,4.35L-33.174,4.748L-33.761,5.277ZM-43.229,4.78L-43.099,4.619L-43.099,4.73L-42.928,4.852L-42.843,5.05L-42.971,5.157L-43.211,4.904L-43.229,4.78ZM-43.184,4.24L-43.099,4.459L-43.208,4.478L-43.515,4.238L-43.451,3.975L-43.357,3.92L-43.1,3.968L-43.145,4.08L-43.018,4.24L-43.184,4.24ZM-46.956,3.82L-46.978,3.726L-46.889,3.695L-46.866,3.79L-46.956,3.82ZM-43.75,3.788L-43.984,3.69L-44.172,3.536L-44.04,3.44L-43.717,3.461L-43.655,3.552L-43.75,3.788ZM-45.47,3.618L-45.679,3.614L-45.736,3.416L-45.602,3.434L-45.47,3.618ZM-41.725,1.837L-41.529,1.658L-41.4,1.72L-41.536,1.962L-41.725,1.837Z", "events": [{"year": -416, "title": "Segesta and Selinus", "text": "Elymian Segesta and Greek Selinus fight over border land and marriage rights; Syracuse backs Selinus.", "lon": -56.391, "lat": -9.875}, {"year": -416, "title": "Envoys to Athens", "text": "Beaten, Segesta sends envoys to Athens, invoking an alliance made in 427 BC.", "lon": -56.366, "lat": -8.462}, {"year": -416, "title": "Leontini's exiles", "text": "Exiles from Leontini, absorbed by Syracuse in 422 BC, join the appeal to Athens.", "lon": -42.889, "lat": -13.547}, {"year": -416, "title": "Motya", "text": "The Phoenician island city in its lagoon anchors Carthage's sphere in western Sicily.", "lon": -58.637, "lat": -9.04}, {"year": -416, "title": "Carthage watches", "text": "Carthage, mistress of the west since its defeat at Himera in 480 BC, stays out of the quarrel.", "lon": -71.99, "lat": -16.961}, {"year": -415, "title": "Treasures of Eryx", "text": "Athenian envoys are shown gold and silver plate at Segesta and the temple of Eryx, much of it borrowed.", "lon": -57.903, "lat": -7.712}, {"year": -415, "title": "Armada at Rhegium", "text": "One hundred and thirty-four triremes gather at Rhegium; the city refuses to join them.", "lon": -38.845, "lat": -7.141}, {"year": -415, "title": "Only thirty talents", "text": "Scouts learn that Segesta can pay just thirty talents; its promised riches were a show.", "lon": -56.329, "lat": -8.547}, {"year": -415, "title": "Messana refuses", "text": "Alcibiades fails to win over Messana, the city guarding the strait.", "lon": -39.429, "lat": -6.493}, {"year": -415, "title": "Naxos joins Athens", "text": "Chalcidian Naxos opens its gates to the Athenian fleet.", "lon": -41.165, "lat": -9.391}, {"year": -415, "title": "Catana taken", "text": "Athenian soldiers slip through a badly built gate; Catana becomes Athens' base.", "lon": -42.348, "lat": -11.891}, {"year": -415, "title": "Alcibiades recalled", "text": "The state galley arrives at Catana to bring Alcibiades home for trial; he escapes and goes to Sparta.", "lon": -42.267, "lat": -11.985}, {"year": -415, "title": "Hyccara enslaved", "text": "Nicias sacks the Sicanian town of Hyccara and sells its people for one hundred and twenty talents.", "lon": -54.276, "lat": -6.985}, {"year": -415, "title": "Battle of the Anapus", "text": "The Athenians win a pitched battle near the Olympieion, but without cavalry they cannot follow it up.", "lon": -41.271, "lat": -15.422}, {"year": -415, "title": "Hermocrates in command", "text": "Syracuse elects Hermocrates one of three generals and extends its walls.", "lon": -41.066, "lat": -15.305}, {"year": -414, "title": "Epipolae seized", "text": "Landing at dawn near Leon, the Athenians seize the plateau above Syracuse.", "lon": -41.52, "lat": -15.109}, {"year": -414, "title": "The Circle", "text": "The Athenians build a round fort on Epipolae and start walls to cut Syracuse off.", "lon": -41.333, "lat": -15.109}, {"year": -414, "title": "Lamachus killed", "text": "The general Lamachus dies in a skirmish in the marshes below Epipolae.", "lon": -41.271, "lat": -15.344}, {"year": -414, "title": "Gylippus at Himera", "text": "The Spartan Gylippus lands at Himera and marches on Syracuse with Sicilian volunteers.", "lon": -50.213, "lat": -8.212}, {"year": -414, "title": "Selinus and Gela march", "text": "Selinus, Gela and some Sicels send troops to join Gylippus.", "lon": -47.556, "lat": -15.266}, {"year": -414, "title": "The counter-wall", "text": "A Syracusan wall across Epipolae blocks the Athenian siege works for good.", "lon": -41.396, "lat": -15.031}, {"year": -414, "title": "Sicels side with Athens", "text": "Many Sicel towns of the interior send men and grain to the Athenian camp.", "lon": -47.369, "lat": -11.383}, {"year": -414, "title": "Camarina debate", "text": "Hermocrates and the Athenian Euphemus compete for Camarina's support; it stays neutral.", "lon": -46.33, "lat": -16.812}, {"year": -413, "title": "Plemmyrium falls", "text": "Gylippus captures the Athenian forts and stores at the harbour mouth.", "lon": -40.96, "lat": -15.5}, {"year": -413, "title": "Demosthenes arrives", "text": "A second fleet of seventy-three triremes brings Demosthenes and some five thousand hoplites.", "lon": -41.147, "lat": -15.422}, {"year": -413, "title": "Night battle", "text": "Demosthenes' moonlit assault on Epipolae collapses in confusion.", "lon": -41.539, "lat": -15.125}, {"year": -413, "title": "Camarina sends troops", "text": "Camarina sends five hundred hoplites and light troops to Syracuse.", "lon": -46.311, "lat": -16.75}, {"year": -413, "title": "Eclipse of the moon", "text": "On 27 August a lunar eclipse persuades Nicias to delay the retreat.", "lon": -41.209, "lat": -15.344}, {"year": -413, "title": "Battle in the Great Harbour", "text": "The Athenian fleet is crushed trying to break out of the harbour.", "lon": -41.209, "lat": -15.461}, {"year": -413, "title": "Massacre at the Assinarus", "text": "Nicias' retreating column is slaughtered as it fights to drink from the river.", "lon": -42.267, "lat": -16.75}, {"year": -413, "title": "The quarries", "text": "About seven thousand prisoners are penned in the stone quarries; Nicias and Demosthenes are executed.", "lon": -41.147, "lat": -15.187}, {"year": -413, "title": "Akragas holds aloof", "text": "Akragas refuses to fight for either side.", "lon": -51.687, "lat": -13.547}, {"year": -412, "title": "Syracuse sails east", "text": "Hermocrates leads Syracusan and Selinuntine ships to fight Athens in the Aegean.", "lon": -41.022, "lat": -15.344}, {"year": -410, "title": "Selinus presses Segesta", "text": "Selinus seizes more of Segesta's border land.", "lon": -56.453, "lat": -10.344}, {"year": -410, "title": "Segesta turns to Carthage", "text": "Segesta's envoys offer Carthage their city in return for protection.", "lon": -71.947, "lat": -16.906}, {"year": -410, "title": "Hannibal Mago", "text": "Carthage gives command to Hannibal, grandson of the Hamilcar who died at Himera.", "lon": -72.071, "lat": -17.062}, {"year": -410, "title": "Libyans and Campanians", "text": "Five thousand Libyans and eight hundred Campanian horsemen defeat the Selinuntines.", "lon": -56.578, "lat": -8.938}, {"year": -409, "title": "Hannibal lands", "text": "Sixty warships and some fifteen hundred transports land a huge army at Cape Lilybaeum.", "lon": -58.837, "lat": -9.586}, {"year": -409, "title": "Fall of Selinus", "text": "Selinus falls after nine days; some sixteen thousand die and five thousand are enslaved.", "lon": -56.429, "lat": -11.258}, {"year": -409, "title": "Refugees at Akragas", "text": "About two thousand six hundred Selinuntines escape to Akragas.", "lon": -51.662, "lat": -13.469}, {"year": -409, "title": "Himera destroyed", "text": "Hannibal razes Himera and puts three thousand prisoners to death where his grandfather fell.", "lon": -50.231, "lat": -8.235}], "eras": [[-416, -416, "The Feud in the West"], [-415, -415, "The Great Armada"], [-414, -413, "The Siege of Syracuse"], [-412, -410, "Segesta Turns to Carthage"], [-409, -409, "Hannibal's Invasion"]], "refLine": null, "metrics": [{"label": "Carthaginian & Elymian", "stages": [1]}, {"label": "Athenian-aligned", "stages": [3]}], "chartNote": "Share of the area of today's Sicilian provinces and Reggio Calabria, by the side taken by each province's leading ancient community. Regions are today's boundaries; ancient city-states were far smaller, and one province could hold cities on both sides (Trapani held both Segesta and Selinus). A simplification: allegiances shifted with each campaign season.", "chartTitle": "Sicily's allegiances by area", "shares": [[0.5039, 0.2604, 0.1476, 0.0, 0.0881], [0.3812, 0.1747, 0.1476, 0.2084, 0.0881], [0.3812, 0.1747, 0.1476, 0.2084, 0.0881], [0.3256, 0.1747, 0.2032, 0.2084, 0.0881], [0.4483, 0.1747, 0.2032, 0.0856, 0.0881], [0.4483, 0.1747, 0.2032, 0.0856, 0.0881], [0.4483, 0.2604, 0.2032, 0.0, 0.0881], [0.4483, 0.2604, 0.2032, 0.0, 0.0881]], "seaTile": "data:image/svg+xml;base64,", "theme": {"--sea": "#14304A", "--sea-deep": "#0B1D2E", "--shade": "10,20,30", "--neighbor": "#2E4556", "--neighbor-edge": "#5B7385", "--glaze": "#F8F2E8", "--gold": "#B9863F", "--gold-bright": "#DDAE62", "--accent": "#6B1F4E", "--accent-hover": "#842862", "--ink": "#1E1A22", "--ink-muted": "#625A66", "--paper": "#F2EBDF", "--font-display": "'Marcellus', 'Noto Serif', 'DejaVu Serif', 'Noto Sans CJK JP', Georgia, serif", "--font-body": "'Cardo', 'Noto Serif', 'DejaVu Serif', 'Noto Sans CJK JP', Georgia, serif", "--cobalt": "#14304A", "--cobalt-deep": "#0B1D2E", "--wine": "#6B1F4E"}}